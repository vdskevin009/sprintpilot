<div class="grid-wrap" id="work-grid" tabindex="0" aria-label="Sprint work items. Control A selects visible items.">
<datalist id="work-grid-tags">@foreach(var tag in TagSuggestions){<option value="@tag"></option>}</datalist>
<table><thead><tr><th class="check"><input type="checkbox" aria-label="Select all visible" checked="@(Items.Count>0&&Items.All(x=>Selected.Contains(x.Id)))" @onchange="()=>SelectAll.InvokeAsync()"/></th>
@foreach(var column in Columns){<th><button class="sort" @onclick="()=>Sort.InvokeAsync(column)">@column @(SortedBy==column?(Descending?"↓":"↑"):"")</button></th>}
</tr></thead><tbody>
@foreach(var w in Items){<tr @key="w.Id" class="@(Selected.Contains(w.Id)?"selected":"") @(Busy.Contains(w.Id)?"saving":"")">
<td class="check"><input type="checkbox" aria-label="Select work item @w.Id" checked="@Selected.Contains(w.Id)" @onclick="e=>Select.InvokeAsync((w.Id,e.ShiftKey))"/></td>
@foreach(var column in Columns){<td class="col-@column.ToLowerInvariant()">
@switch(column){
case "ID":<span class="item-id">#@w.Id</span>@if(Busy.Contains(w.Id)){<span class="save-dot" aria-label="Saving">•••</span>}break;
case "Type":<span class="type-icon @(w.Type=="Bug"?"bug":"")" title="@w.Type">@(w.Type=="Bug"?"◆":"▣")</span><span class="type-name">@w.Type</span>break;
case "Title":<button class="title-button" @onclick="()=>Open.InvokeAsync(w)">@w.Title</button>@if(Drafts.Contains(w.Id)){<span class="draft">Local draft</span>}break;
case "Owner":<select aria-label="Assign @w.Id" value="@OwnerValue(w)" disabled="@Busy.Contains(w.Id)" @onchange="e=>Edit.InvokeAsync((w,ItemField.Owner,e.Value?.ToString()??string.Empty))"><option value="">Unassigned</option>@if(w.OwnerId!=""&&!Meta.People.Any(p=>p.Id==w.OwnerId)){<option value="@OwnerValue(w)">@w.Owner</option>}@foreach(var p in Meta.People){<option value="@p.UniqueName">@p.Name</option>}</select>break;
case "State":<select class="state" aria-label="State for @w.Id" value="@w.State" disabled="@Busy.Contains(w.Id)" @onchange="e=>Edit.InvokeAsync((w,ItemField.State,e.Value?.ToString()??string.Empty))">@foreach(var s in Meta.Types.FirstOrDefault(t=>t.Name==w.Type)?.States??[]){<option>@s.Name</option>}</select>break;
case "Iteration":<select aria-label="Sprint for @w.Id" value="@w.Iteration" disabled="@Busy.Contains(w.Id)" @onchange="e=>Edit.InvokeAsync((w,ItemField.Iteration,e.Value?.ToString()??string.Empty))">@foreach(var i in Meta.Iterations){<option value="@i.Path">@i.Name</option>}</select>break;
case "Area":<select aria-label="Area for @w.Id" value="@w.Area" disabled="@Busy.Contains(w.Id)" @onchange="e=>Edit.InvokeAsync((w,ItemField.Area,e.Value?.ToString()??string.Empty))">@foreach(var a in Meta.Areas){<option>@a</option>}</select>break;
case "Estimate":<input class="number" aria-label="Estimate for @w.Id" type="number" min="0" step="0.5" value="@w.Estimate?.ToString(CultureInfo.InvariantCulture)" disabled="@(Busy.Contains(w.Id)||Meta.Types.FirstOrDefault(t=>t.Name==w.Type)?.EstimateField is null)" @onchange="e=>Edit.InvokeAsync((w,ItemField.Estimate,e.Value?.ToString()??string.Empty))"/>break;
case "Order":<input class="order-number" aria-label="Backlog order for @w.Id" type="number" min="0" step="1" value="@w.Order?.ToString(CultureInfo.InvariantCulture)" disabled="@(Busy.Contains(w.Id)||Meta.Types.FirstOrDefault(t=>t.Name==w.Type)?.OrderField is null)" @onchange="e=>Edit.InvokeAsync((w,ItemField.Order,e.Value?.ToString()??string.Empty))"/>break;
case "Priority":<input class="number" aria-label="Priority for @w.Id" type="number" min="1" max="4" value="@w.Priority" disabled="@Busy.Contains(w.Id)" @onchange="e=>Edit.InvokeAsync((w,ItemField.Priority,e.Value?.ToString()??string.Empty))"/>break;
case "Parent":@if(w.Parent is {} parentId){<button @onclick="()=>OpenParent.InvokeAsync(parentId)">#@parentId</button>}else{<span class="muted">—</span>}break;
case "Tags":<input class="tag-input" list="work-grid-tags" aria-label="Tags for @w.Id, separated by semicolons" placeholder="Type or choose tags" value="@string.Join("; ",w.Tags)" disabled="@Busy.Contains(w.Id)" @onchange="e=>Edit.InvokeAsync((w,ItemField.Tags,e.Value?.ToString()??string.Empty))"/>break;
case "Changed":<span class="muted" title="@w.Changed.ToString("u")">@w.Changed.ToLocalTime().ToString("MMM d, HH:mm")</span>break;
}
</td>}
</tr>}
</tbody></table>
@if(Items.Count==0){<div class="empty"><h2>No work items here</h2><p>Try another sprint or clear the filters.</p></div>}
</div>
@code {
[Parameter]public IReadOnlyList<WorkItem> Items{get;set;}=[];
[Parameter]public Metadata Meta{get;set;}=default!;
[Parameter]public string[] Columns{get;set;}=[];
[Parameter]public HashSet<int> Selected{get;set;}=[];
[Parameter]public HashSet<int> Busy{get;set;}=[];
[Parameter]public HashSet<int> Drafts{get;set;}=[];
[Parameter]public IReadOnlyList<string> TagSuggestions{get;set;}=[];
[Parameter]public string SortedBy{get;set;}="ID";
[Parameter]public bool Descending{get;set;}
[Parameter]public EventCallback<string> Sort{get;set;}
[Parameter]public EventCallback<(int Id,bool Shift)> Select{get;set;}
[Parameter]public EventCallback SelectAll{get;set;}
[Parameter]public EventCallback<WorkItem> Open{get;set;}
[Parameter]public EventCallback<int> OpenParent{get;set;}
[Parameter]public EventCallback<(WorkItem Item,ItemField Field,string Value)> Edit{get;set;}
string OwnerValue(WorkItem w)=>Meta.People.FirstOrDefault(p=>p.Id==w.OwnerId)?.UniqueName??w.Owner;
}
