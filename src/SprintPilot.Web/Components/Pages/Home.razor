@page "/"
@implements IAsyncDisposable
@inject TrackerSession Tracker
@inject ICredentialStore Credentials
@inject IPreferencesStore Preferences
@inject BulkEditor Bulk
@inject IJSRuntime JS

<div class="app-shell">
<aside class="rail"><a class="brand" href="/" aria-label="SprintPilot home"><img src="icon.svg" alt=""/><span><strong>SprintPilot</strong><small>KV Solutions</small></span></a>
<div class="workspace-label">Orchestration</div>
<button class="nav-button @(screen=="home"?"active":"")" disabled="@(meta is null)" @onclick='()=>SetScreen("home")'>⌂ Home</button>
<button class="nav-button @(screen=="daily"?"active":"")" disabled="@(meta is null)" @onclick='()=>SetScreen("daily")'>◉ Daily</button>
<button class="nav-button @(screen=="meeting"?"active":"")" disabled="@(meta is null)" @onclick='()=>SetScreen("meeting")'>✎ Meetings</button>
<div class="workspace-label">Workspace</div>
<button class="nav-button @(screen=="workspace"?"active":"")" disabled="@(meta is null)" @onclick='()=>SetScreen("workspace")'>▦ Sprint workspace</button>
<button class="nav-button @(screen=="cleanup"?"active":"")" disabled="@(meta is null)" @onclick="OpenCleanup">◷ Sprint cleanup</button>
<div class="workspace-label">Saved views <button title="Save current view" disabled="@(meta is null)" @onclick='()=>Show("saveview")'>+</button></div>
@foreach(var view in prefs.Views){<button class="nav-button" @onclick="()=>LoadView(view)">⌑ @view.Name</button>}
<div class="rail-bottom"><button class="nav-button" @onclick='()=>SetScreen("settings")'>⚙ Settings</button><button class="nav-button" title="Command palette (Ctrl+K)" @onclick='()=>Show("palette")'>⌘ Commands <kbd>Ctrl K</kbd></button><div class="connection-dot">● @(Tracker.Demo?"Demo workspace":meta is null?"Not connected":"Azure DevOps connected")</div></div></aside>
<main>
<header class="topbar"><span class="topbar-context">@(Tracker.Demo?"Demo / Platform team":connection is null?"Local workspace":connection.Organization+" / "+connection.Project)</span><span class="topbar-product">KV Solutions <i>·</i> SprintPilot</span><span class="muted">@meta?.Me.Name</span></header>
@if(Tracker.Demo){<div class="demo-banner">Demo mode — changes stay in this browser session. <button @onclick="ExitDemo">Connect Azure DevOps</button></div>}
@if(message!=""){<div class="notice @(hasError?"error":"")" role="status">@message <button aria-label="Dismiss notification" @onclick="()=>message=string.Empty">×</button></div>}
@if(initializing){<div class="empty"><h1>Opening SprintPilot…</h1></div>}
else if(screen=="settings"){
<section class="settings"><div class="page-heading"><div><h1>Settings</h1><p>Make SprintPilot work the way you do.</p></div><button class="primary" @onclick="SaveSettings">Save settings</button></div>
<h2>Appearance</h2><label>Theme<select @bind="prefs.Theme" @bind:after="ApplyTheme"><option value="system">System</option><option value="dark">Dark</option><option value="light">Light</option><option value="avd">AVD friendly</option></select><small>AVD friendly uses light solid surfaces, stronger borders, and minimal visual effects to reduce remote-desktop compression artifacts.</small></label>
<h2>Connection</h2><p>@(connection?.Organization??"No organization") / @(connection?.Project??"No project")</p><button @onclick="ChangeConnection">Change connection</button>
@if(meta is not null&&!Tracker.Demo){<label>Team<select value="@connection?.Team" @onchange="ChangeTeam">@foreach(var t in meta.Teams){<option value="@t.Id">@t.Name</option>}</select></label>}
<h2>Blocked work</h2><p>Work items with any of these Azure DevOps tags are shown as Blocked everywhere in SprintPilot.</p><label>Blocked tags (one per line)<textarea rows="5" @bind="blockedTagsText"></textarea></label>
<h2>Public holidays</h2><p>Belgium, Canada, Québec, Poland, Czechia and Germany are always available in Home and Daily. SprintPilot refreshes them online when possible and falls back to its built-in calendar when the network is unavailable.</p>@if(holidayCalendarError!=""){<p class="muted">@holidayCalendarError</p>}
<h2>Applications &amp; initiatives</h2><p>These classifications stay local to SprintPilot. The Azure DevOps tags themselves are not changed.</p>
<div class="toolbar"><input list="settings-known-tags" placeholder="Add a tag to classify…" @bind="classificationTag"/><datalist id="settings-known-tags">@foreach(var known in KnownPlanningTags){<option value="@known"></option>}</datalist><button @onclick="AddClassification">Add classification</button></div>
@if(PlanningPrefs.Tags.Count>0){<div class="settings-tag-grid">@foreach(var tag in PlanningPrefs.Tags.ToArray()){<div class="settings-tag-row"><strong>@tag.Tag</strong><label class="checkbox"><input type="checkbox" checked="@tag.Application" @onchange="e=>SetClassification(tag.Tag,true,e.Value is true)"/>Application</label><label class="checkbox"><input type="checkbox" checked="@tag.Initiative" @onchange="e=>SetClassification(tag.Tag,false,e.Value is true)"/>Initiative</label><button class="text-button" @onclick="()=>RemoveClassification(tag.Tag)">Remove</button></div>}</div>}
@if(PlanningPrefs.Tags.Any(t=>t.Initiative)){<h3>Initiative orchestration</h3><p>Due date, status, confidence and notes are local SprintPilot metadata.</p><div class="initiative-settings">@foreach(var tag in PlanningPrefs.Tags.Where(t=>t.Initiative).ToArray()){var initiative=Initiative(tag.Tag);<div class="initiative-setting-row"><strong>@tag.Tag</strong><label>Due date<input type="date" value="@(initiative.DueDate?.ToString("yyyy-MM-dd")??"")" @onchange="e=>SetInitiativeDueDate(tag.Tag,e)"/></label><label>Status<select value="@initiative.Status" @onchange="e=>SetInitiativeStatus(tag.Tag,e)"><option>Ongoing</option><option>On Track</option><option>At Risk</option><option>Blocked</option></select></label><label>Confidence<select value="@initiative.Confidence" @onchange="e=>SetInitiativeConfidence(tag.Tag,e)"><option>High</option><option>Medium</option><option>Low</option></select></label><label class="initiative-note">Comment<input value="@initiative.Comment" @onchange="e=>SetInitiativeComment(tag.Tag,e)" placeholder="Short orchestration note"/></label></div>}</div>}
<h3>Capacity</h3><p>Capacity defaults to 60 hours per sprint. On a standard 10-working-day sprint that is 6 hours per day. Home shows remaining work against remaining time, prorates the sprint as days pass, and removes Azure DevOps days off plus the public-holiday calendar assigned to each person.</p>
<div class="capacity-settings"><label>Default sprint capacity (h)<input type="number" min="0" step="0.5" value="@PlanningPrefs.DefaultTarget.Maximum" @onchange="SetDefaultCapacityHours"/></label></div>
<label class="checkbox"><input type="checkbox" checked="@PlanningPrefs.EstimatesAreHours" @onchange="SetPlanningHours"/>Treat configured estimates as hours</label>
@if(meta is not null){<div class="capacity-overrides"><div class="capacity-overrides-head"><strong>People</strong><span>Default capacity and holiday calendar</span></div>@foreach(var person in meta.People){<div class="capacity-override-row capacity-person-setting"><strong>@person.Name</strong><label>Capacity / sprint (h)<input type="number" min="0" step="0.5" value="@PersonCapacityHours(person.Id)" @onchange="e=>SetPersonCapacityHours(person.Id,e)"/></label><label>Public holidays<select value="@HolidayCalendarForPerson(person.Id)" @onchange="e=>SetPersonHolidayCalendar(person.Id,e)"><option value="">None</option>@foreach(var country in HolidayCountries){<option value="@country.Code">@country.Name</option>}</select></label>@if(HasPersonCapacityHours(person.Id)){<button class="text-button" @onclick="()=>ClearPersonCapacityHours(person.Id)">Use 60h default</button>}</div>}</div>}
<h2>AI review</h2><p>Copy prompts into your chosen AI tool, then paste its structured response back here.</p><label>Master instructions<textarea rows="14" @bind="prefs.AiPrompt"></textarea></label><button @onclick="()=>prefs.AiPrompt=AiReview.DefaultPrompt">Restore default prompt</button>
<h2>Quality checklist</h2><p>A configurable heuristic, not an objective measure of work quality. Zero disables a rule.</p><div class="weights">@foreach(var key in prefs.QualityWeights.Keys.ToArray()){<label>@key<input type="number" min="0" max="100" @bind="prefs.QualityWeights[key]"/></label>}</div><label>Stale after this many days<input type="number" min="1" @bind="prefs.StaleDays"/></label>
<h2>Work-item templates</h2><div class="toolbar"><select aria-label="Template to edit" @bind="templateIndex" @bind:after="LoadTemplate">@for(int i=0;i<prefs.Templates.Count;i++){<option value="@i">@prefs.Templates[i].Name</option>}</select><button @onclick="NewTemplate">+ Template</button><button @onclick="DeleteTemplate">Delete</button></div>
<label>Name<input @bind="templateName"/></label><label>Description<textarea rows="5" @bind="templateDescription"></textarea></label><label>Acceptance criteria / testing<textarea rows="4" @bind="templateAcceptance"></textarea></label><label>Tags<input @bind="templateTags"/></label><label>Area<input @bind="templateArea"/></label><button @onclick="SaveTemplate">Update template</button>
<h2>Saved views</h2>@foreach(var v in prefs.Views.ToArray()){<div class="toolbar">@v.Name<button @onclick="()=>DeleteView(v)">Delete</button></div>}
</section>
}
else if(meta is null){
<section class="welcome"><img src="icon.svg" alt=""/><h1>Welcome to SprintPilot</h1><p>Azure DevOps connection required.</p>
<label>Organization<input placeholder="your-organization" @bind="organization" @bind:after="ResetTest"/></label><label>Project<input placeholder="Your project" @bind="project" @bind:after="ResetTest"/></label><label>Token<input id="pat" type="password" autocomplete="off" @oninput="TokenInput"/></label>
<p class="muted">The token stays on this machine. On Windows, local saving uses Credential Manager.</p>
<div class="toolbar"><button disabled="@connecting" @onclick="TestConnection">Test connection</button><button class="primary" disabled="@connecting" @onclick="SaveConnection">Save locally</button></div>
@if(testUser is not null){<p class="success">✓ Connected as @testUser.Name</p>}
<button class="text-button" @onclick="ExploreDemo">Explore with demo data</button></section>
}
else if(screen=="home"){
<section class="orchestration-home">
<div class="page-heading home-heading"><div><div class="heading-context">@meta.Teams.FirstOrDefault(t=>t.Id==connection?.Team)?.Name · @CurrentSprint?.Name</div><h1>Home</h1><p>Orchestrate what still needs attention. Completed work stays out of the way.</p></div><div class="toolbar home-actions">@if(!pwaInstalled){<button class="install-app-button @(pwaInstallAvailable?"ready":"")" title="Install SprintPilot as a Progressive Web App" @onclick="InstallPwa">⊕ Install app</button>}@if(appUpdateChecking){<button disabled>Checking update…</button>}else if(appUpdateAvailable&&appUpdateSupported){<button class="update-app-button" title="@appUpdateText" disabled="@appUpdating" @onclick="StartAppUpdate">@(appUpdating?"Updating…":"↑ Update")</button>}<button class="magic-orchestration-trigger" disabled="@loading" @onclick="PrepareMagicOrchestration">✨ Magic Orchestration</button><button disabled="@loading" @onclick="Refresh">↻ Refresh</button><button @onclick='()=>SetScreen("daily")'>Open Daily →</button></div></div>
<div class="home-layout">
<section class="home-card attention-card"><header><div><span class="eyebrow">Now</span><h2>Needs attention</h2></div><span class="home-card-count">@HomeAttention().Sum(x=>x.Count)</span></header>
@if(HomeAttention().Count==0){<div class="home-empty">Nothing urgent in the current sprint.</div>}else{<div class="attention-list">@foreach(var row in HomeAttention()){<button @onclick="()=>OpenAttention(row.Key)"><span class="attention-number">@row.Count</span><span><strong>@row.Label</strong><small>@row.Hint</small></span><span>→</span></button>}</div>}</section>
<div class="capacity-comparison"><section class="home-card capacity-card sprint-capacity-card"><header><div><span class="eyebrow">Current sprint</span><h2>@(CurrentSprint?.Name??"Current sprint")</h2></div><span class="home-card-count">@CapacityRowsFor(CurrentSprint).Sum(x=>x.Count)</span></header>@if(!PlanningPrefs.EstimatesAreHours){<div class="capacity-note">Capacity is ready; enable “Treat configured estimates as hours” in Settings to compare remaining estimates with it.</div>}<div class="capacity-list">@foreach(var person in CapacityRowsFor(CurrentSprint)){<button @onclick="()=>OpenPerson(person.Id)"><span class="capacity-person"><strong>@person.Name</strong><small>@person.Count @(person.Count==1?"item":"items") · @person.Effort.ToString("0.#")h work / @person.CapacityHours.ToString("0.#")h available</small></span><span class="mini-meter capacity-meter @(person.Percent>100?"over":person.Percent>=85?"near":"")" title="@CapacityMeterTitle(person)" aria-label="@CapacityMeterTitle(person)"><i class="capacity-fill" style="@($"width:{CapacityFillPercent(person)}%")"></i>@if(person.Percent>100){<i class="capacity-overage" style="@($"width:{CapacityOveragePercent(person)}%")"></i>}</span><span class="capacity-state @person.Status.ToLowerInvariant().Replace(" ","-")"><strong>@person.Status</strong><small>@CapacityLoadText(person)</small></span>@if(person.MissingEstimates>0){<small class="missing-estimate">@person.MissingEstimates not estimated</small>}<small class="capacity-baseline">@CapacityBaselineText(person.Id,CurrentSprint)</small>@if(person.NextLeave is not null){<small class="capacity-leave">Next off · @RangeText(person.NextLeave)</small>}</button>}</div></section>
<section class="home-card capacity-card sprint-capacity-card"><header><div><span class="eyebrow">Next sprint</span><h2>@(NextSprint?.Name??"Not configured")</h2></div><span class="home-card-count">@CapacityRowsFor(NextSprint).Sum(x=>x.Count)</span></header>@if(NextSprint is null){<div class="home-empty">No next sprint is configured.</div>}else{<div class="capacity-list">@foreach(var person in CapacityRowsFor(NextSprint)){<button @onclick="()=>OpenSprintPerson(NextSprint!,person.Id)"><span class="capacity-person"><strong>@person.Name</strong><small>@person.Count @(person.Count==1?"item":"items") · @person.Effort.ToString("0.#")h work / @person.CapacityHours.ToString("0.#")h available</small></span><span class="mini-meter capacity-meter @(person.Percent>100?"over":person.Percent>=85?"near":"")" title="@CapacityMeterTitle(person)" aria-label="@CapacityMeterTitle(person)"><i class="capacity-fill" style="@($"width:{CapacityFillPercent(person)}%")"></i>@if(person.Percent>100){<i class="capacity-overage" style="@($"width:{CapacityOveragePercent(person)}%")"></i>}</span><span class="capacity-state @person.Status.ToLowerInvariant().Replace(" ","-")"><strong>@person.Status</strong><small>@CapacityLoadText(person)</small></span>@if(person.MissingEstimates>0){<small class="missing-estimate">@person.MissingEstimates not estimated</small>}<small class="capacity-baseline">@CapacityBaselineText(person.Id,NextSprint)</small>@if(person.NextLeave is not null){<small class="capacity-leave">Next off · @RangeText(person.NextLeave)</small>}</button>}</div>}</section></div>
<section class="home-card time-off-card"><header><div><span class="eyebrow">Upcoming</span><h2>Days off &amp; public holidays</h2></div></header><div class="holiday-filters"><button class="@(holidayCountryFilter=="ALL"?"active":"")" @onclick='()=>SetHolidayCountry("ALL")'>All</button>@foreach(var country in HolidayCountries){<button class="@(holidayCountryFilter==country.Code?"active":"")" @onclick="()=>SetHolidayCountry(country.Code)">@country.Name</button>}</div>@if(HomeTimeOffDays().Count==0){<div class="home-empty">No upcoming time off found.</div>}else{<div class="time-off-list">@foreach(var day in HomeTimeOffDays()){<div class="time-off-day"><span><strong>@day.Title</strong><span class="time-off-source-pills">@foreach(var source in day.Sources){<i class="time-off-source-pill">@source</i>}</span></span><time>@TimeOffDateText(day.Date)</time></div>}</div>}</section>
<section class="home-card work-summary-card"><header><div><span class="eyebrow">Remaining work</span><h2>Applications</h2></div></header>@if(Remaining(TagDimension.Application).Count==0){<div class="home-empty">Classify application tags in Settings.</div>}else{<div class="work-group-list">@foreach(var group in Remaining(TagDimension.Application)){<button @onclick="()=>OpenGroup(group.Name)"><strong>@group.Name</strong><span>@group.Count items</span><small>@group.Effort.ToString("0.#") effort</small></button>}</div>}</section>
<section class="home-card work-summary-card"><header><div><span class="eyebrow">Remaining work</span><h2>Initiatives</h2></div></header>@if(InitiativeRows().Count==0){<div class="home-empty">Classify initiative tags in Settings.</div>}else{<div class="initiative-list">@foreach(var row in InitiativeRows()){<button class="@(row.NeedsAttention?"needs-attention":"")" @onclick="()=>OpenGroup(row.Tag)"><span><strong>@row.Tag</strong><small>@row.Count items · @row.Effort.ToString("0.#") effort</small></span><span class="initiative-meta"><em>@row.Meta.Status</em><em>@row.Meta.Confidence confidence</em>@if(row.Meta.DueDate is not null){<em>Due @row.Meta.DueDate.Value.ToString("MMM d")</em>}</span></button>}</div>}</section>
</div>
</section>
}
else if(screen=="meeting"){
<section class="meeting-page">
<div class="page-heading meeting-heading"><div><div class="heading-context">Capture → structure → create</div><h1>Meeting workspace</h1><p>Take rough notes during the meeting, let Copilot structure them, then review and create the useful actions in Azure DevOps.</p></div><button @onclick="ResetMeeting">New meeting</button></div>
<div class="meeting-grid">
<section class="meeting-card meeting-notes"><header><div><span class="eyebrow">1 · Capture</span><h2>Meeting notes</h2></div></header><label>Meeting title<input @bind="meetingTitle"/></label><label>Rough notes<textarea rows="16" @bind="meetingNotes" placeholder="Write freely during the meeting. Decisions, requests, constraints, actions…"></textarea></label><div class="meeting-actions"><button class="primary" @onclick="CopyMeetingPrompt">Copy prompt for Copilot</button><small>Paste the prompt into Copilot. SprintPilot does not send your notes to an AI service.</small></div></section>
<section class="meeting-card meeting-import"><header><div><span class="eyebrow">2 · Structure</span><h2>Copilot result</h2></div></header><label>Paste Copilot JSON<textarea rows="16" @bind="meetingCopilotText" placeholder="Paste Copilot's raw JSON response here…"></textarea></label><button class="primary" @onclick="ParseMeetingCopilot">Import &amp; review</button>@if(meetingError!=""){<p class="error-text">@meetingError</p>}</section>
</div>
@if(meetingImport.Summary.Length>0||meetingImport.Decisions.Length>0){
<section class="meeting-card meeting-summary"><header><div><span class="eyebrow">Review</span><h2>Meeting summary</h2></div><button @onclick="CopyMeetingSummary">Copy summary</button></header><div class="meeting-summary-grid">@if(meetingImport.Summary.Length>0){<div><h3>Summary</h3><ul>@foreach(var line in meetingImport.Summary){<li>@line</li>}</ul></div>}@if(meetingImport.Decisions.Length>0){<div><h3>Decisions</h3><ul>@foreach(var line in meetingImport.Decisions){<li>@line</li>}</ul></div>}</div></section>}
@if(meetingActions.Count>0){
<section class="meeting-card meeting-backlog"><header><div><span class="eyebrow">3 · Act</span><h2>Backlog candidates</h2><p>Nothing is written to Azure DevOps until you press Create selected.</p></div><label class="meeting-type">Work-item type<select @bind="meetingWorkType">@foreach(var type in meta.Types.Where(t=>t.Name!="Task")){<option value="@type.Name">@type.Name</option>}</select></label></header><div class="meeting-batch-actions"><span>Selected actions</span><button @onclick="AssignSelectedMeetingActionsToMe">Assign to me</button><button @onclick='()=>SetSelectedMeetingSprint("current")'>Current sprint</button><button disabled="@(NextSprint is null)" @onclick='()=>SetSelectedMeetingSprint("next")'>Next sprint</button></div>
<div class="meeting-action-list">@foreach(var action in meetingActions){<article class="meeting-action-item @(action.CreatedId is not null?"created":"")"><div class="meeting-action-select"><input type="checkbox" @bind="action.Selected" disabled="@(action.CreatedId is not null)"/></div><div class="meeting-action-body"><label>Title<input @bind="action.Title" disabled="@(action.CreatedId is not null)"/></label><div class="meeting-action-fields"><label>Owner<select @bind="action.Owner" disabled="@(action.CreatedId is not null)"><option value="">Unassigned</option><option value="@meta.Me.UniqueName">Me · @meta.Me.Name</option>@foreach(var person in meta.People.Where(p=>p.Id!=meta.Me.Id)){<option value="@person.UniqueName">@person.Name</option>}</select></label><label>Sprint<select @bind="action.Sprint" disabled="@(action.CreatedId is not null)"><option value="current">Current · @CurrentSprint?.Name</option><option value="next" disabled="@(NextSprint is null)">Next · @(NextSprint?.Name??"not configured")</option></select></label><label>Estimate<input type="number" min="0" step="0.5" @bind="action.SuggestedEstimate" disabled="@(action.CreatedId is not null)"/></label><label>Tags<input @bind="action.TagsText" disabled="@(action.CreatedId is not null)"/></label></div><details><summary>Description &amp; acceptance criteria</summary><label>Description<textarea rows="4" @bind="action.Description" disabled="@(action.CreatedId is not null)"></textarea></label><label>Acceptance criteria<textarea rows="3" @bind="action.AcceptanceCriteria" disabled="@(action.CreatedId is not null)"></textarea></label></details>@if(action.CreatedId is not null){<div class="meeting-created">✓ Created #@action.CreatedId @if(SafeLink(action.CreatedUrl)){<a href="@action.CreatedUrl" target="_blank" rel="noopener noreferrer">Open in Azure DevOps ↗</a>}</div>}</div></article>}</div>
<div class="meeting-create-bar"><span>@meetingActions.Count(a=>a.Selected&&a.CreatedId is null) selected</span><button class="primary" disabled="@meetingCreating" @onclick="CreateMeetingActions">@(meetingCreating?"Creating…":"Create selected backlog items")</button></div>
</section>}
</section>
}
else {
<section class="workspace sprint-workspace @(screen=="daily"?"daily-workspace":"list-workspace") @(screen=="workspace"&&workspaceOwnerMode?"owner-priority-mode":"")"><div class="page-heading compact-heading"><div><div class="heading-context">@meta.Teams.FirstOrDefault(t=>t.Id==connection?.Team)?.Name</div><h1>@(screen=="cleanup"?"Sprint cleanup":screen=="daily"?"Daily":"Sprint workspace")</h1></div><div class="toolbar"><button disabled="@loading" title="Refresh (R)" @onclick="Refresh">↻</button><button class="primary" @onclick="NewItem">+ Work item</button></div></div>
<div class="sprint-bar"><button title="Previous sprint (Alt+Left)" disabled="@(sprintIndex<=0||busy.Count>0)" @onclick="()=>Navigate(-1)">← @Adjacent(-1)</button><button class="current-sprint" @onclick='()=>Show("iterations")'>@CurrentSprint?.Name <span>⌄</span><strong>@items.Count @(items.Count==1?"item":"items")</strong><small>@DateRange</small></button><button title="Next sprint (Alt+Right)" disabled="@(sprintIndex>=meta.Iterations.Length-1||busy.Count>0)" @onclick="()=>Navigate(1)">@Adjacent(1) →</button></div>
@if(screen!="daily"){<div class="view-tabs">@foreach(var v in QuickViews){<button class="@(quickView==v?"active":"")" @onclick="()=>SetQuickView(v)">@v</button>}@if(screen=="workspace"){<button class="workspace-owner-mode @(workspaceOwnerMode?"active":"")" @onclick="ToggleWorkspaceOwnerMode">👤 Prioritize by person</button><button @onclick="PrepareSmartOrder">⚡ Smart order</button>}<button class="prepare" @onclick="PrepareNext">Prepare next sprint →</button></div>@if(screen=="workspace"&&workspaceOwnerMode){<div class="workspace-owner-strip"><span>Priority owner</span>@foreach(var person in WorkspacePriorityPeople){<button class="@(workspacePriorityOwner==person.Id?"active":"")" @onclick="()=>SetWorkspacePriorityOwner(person.Id)">@person.Name <strong>@person.Count</strong></button>}<button class="text-button workspace-owner-exit" @onclick="ToggleWorkspaceOwnerMode">All work ×</button></div>}}
else{<div class="daily-toolbar"><div class="daily-add"><input aria-label="Find work item to add to daily" placeholder="Add item by ID or title…" @bind="dailyLookupText" @bind:event="oninput"/><button disabled="@dailyLookupBusy" @onclick="SearchDailyWork">@(dailyLookupBusy?"Searching…":"Find")</button></div><div class="daily-toolbar-actions"><button class="@(dailyActiveOnly?"active":"")" @onclick="ToggleDailyActiveOnly">@(dailyActiveOnly?"✓ Active only":"Active only")</button></div></div>@if(dailyLookupResults.Count>0){<div class="daily-search-results">@foreach(var result in dailyLookupResults){<button disabled="@busy.Contains(result.Id)" @onclick="()=>AddDailyItem(result)"><span>#@result.Id · @DisplayTitle(result)</span><small>@(result.Owner==""?"Unassigned":result.Owner) · @result.Iteration</small><strong>+ Add</strong></button>}</div>}}
@if(screen=="cleanup"){
<div class="health"><h2>Where this sprint needs attention</h2><p>Use the groups below to narrow the list without hunting through Azure DevOps filters.</p><div class="health-counts">@foreach(var group in CleanupCounts){<button class="@(cleanupFilter==group.Key?"active":"")" @onclick="()=>cleanupFilter=cleanupFilter==group.Key?string.Empty:group.Key"><strong>@group.Value</strong>@group.Key</button>}</div></div>}
<div class="filter-shell"><div class="filter-primary"><input id="search" class="search" aria-label="Search work items" placeholder="Search ID, title, tags…  /" @bind="search" @bind:event="oninput"/><input class="filter-value-search" aria-label="Search filter values" placeholder="Find owner, application or tag…" @bind="filterOptionSearch" @bind:event="oninput"/><button @onclick="()=>moreFilters=!moreFilters">More @(moreFilters?"−":"+")</button>@if(screen!="daily"){<button @onclick='()=>Show("columns")'>Columns</button>}<button class="text-button" @onclick="ClearFilters">Clear</button></div>
<div class="filter-groups">
<div class="filter-group"><span class="filter-group-label">Owner</span><div class="filter-pills">@foreach(var person in FilterPeople){<button class="filter-pill @(ownerFilters.Contains(person.Id)?"active":"")" @onclick="()=>ToggleOwner(person.Id)">@person.Name <strong>@person.Count</strong></button>}</div></div>
@if(screen!="daily"){<div class="filter-group compact-filter-group"><span class="filter-group-label">Work</span><div class="filter-pills"><button class="filter-pill @(workspaceActiveOnly?"active":"")" @onclick="ToggleWorkspaceActiveOnly">Active only</button><button class="filter-pill blocked-filter @(workspaceBlockedOnly?"active":"")" @onclick="ToggleWorkspaceBlockedOnly">Blocked</button></div></div>}
@if(FilterApplications.Any()){<div class="filter-group"><span class="filter-group-label">Applications</span><div class="filter-pills horizontal">@foreach(var app in FilterApplications){<button class="filter-pill @(applicationFilter.Equals(app.Tag,StringComparison.OrdinalIgnoreCase)?"active":"")" @onclick="()=>ToggleApplicationPill(app.Tag)">@app.Tag <strong>@app.Count</strong></button>}</div></div>}
@if(FilterTags.Any()){<div class="filter-group"><span class="filter-group-label">Tags</span><div class="filter-pills horizontal">@foreach(var tag in FilterTags){<button class="filter-pill @(tagFilter.Equals(tag.Tag,StringComparison.OrdinalIgnoreCase)?"active":"")" @onclick="()=>ToggleTagPill(tag.Tag)">@tag.Tag <strong>@tag.Count</strong></button>}</div></div>}
</div>
@if(moreFilters){<div class="filter-more"><input aria-label="Filter type" list="filter-types" placeholder="All types" @bind="typeFilter" @bind:event="oninput"/><datalist id="filter-types">@foreach(var t in CurrentOpenItems.Select(w=>w.Type).Distinct(StringComparer.OrdinalIgnoreCase).Order()){<option value="@t"></option>}</datalist><input aria-label="Filter area" list="filter-areas" placeholder="All areas" @bind="areaFilter" @bind:event="oninput"/><datalist id="filter-areas">@foreach(var a in CurrentOpenItems.Select(w=>w.Area).Distinct(StringComparer.OrdinalIgnoreCase).Order()){<option value="@a"></option>}</datalist><input aria-label="Filter priority" list="filter-priorities" placeholder="All priorities" @bind="priorityFilter" @bind:event="oninput"/><datalist id="filter-priorities">@foreach(var p in CurrentOpenItems.Select(w=>w.Priority).OfType<int>().Distinct().Order()){<option value="@p"></option>}</datalist><button @onclick='()=>Show("saveview")'>Save view</button></div>}</div>
@if(screen!="daily"){<div class="grid-status" aria-live="polite"><span>@Visible.Count work items @(loading?"· Refreshing…":"")</span><span>@(SelectedItems.Count>0?$"{SelectedItems.Count} selected":"Select visible items to edit in bulk")</span><button disabled="@(Visible.Count==0||sprintIndex>=meta.Iterations.Length-1)" @onclick="SelectVisibleAndMoveNext">Move filtered result to next sprint →</button></div>}
@if(screen=="daily"){
@if(UpcomingDaysOff().Count>0||UpcomingHolidays().Count>0){<div class="days-off-summary"><div class="days-off-summary-title"><strong>Days off &amp; holidays</strong><span>Azure DevOps + public holidays</span></div><div class="holiday-filters compact"><button class="@(holidayCountryFilter=="ALL"?"active":"")" @onclick='()=>SetHolidayCountry("ALL")'>All</button>@foreach(var country in HolidayCountries){<button class="@(holidayCountryFilter==country.Code?"active":"")" @onclick="()=>SetHolidayCountry(country.Code)">@country.Name</button>}</div><div class="days-off-periods">@foreach(var leave in VisibleDaysOff()){<span class="leave-period"><strong>@leave.Name</strong> @RangeText(leave.Range) <em class="@(InSelectedSprint(leave.Range)?"current-sprint-leave":"other-sprint-leave")">@(InSelectedSprint(leave.Range)?"Current sprint":"Other sprint")</em></span>}@foreach(var holiday in VisibleHolidays()){<span class="leave-period holiday-period"><strong>@holiday.Name</strong> <small>@holiday.Country</small> @holiday.Start.ToString("MMM d") <em class="@(InSelectedSprint(holiday)?"current-sprint-leave":"other-sprint-leave")">@(InSelectedSprint(holiday)?"Current sprint":"Other sprint")</em></span>}</div>@if(HiddenDaysOffCount()>0||showAllDaysOff){<button class="text-button days-off-more" @onclick="()=>showAllDaysOff=!showAllDaysOff">@(showAllDaysOff?"Show less":$"Show {HiddenDaysOffCount()} more")</button>}</div>}
<div class="daily-person-strip" aria-label="Choose a person for Daily"><button class="@(dailyFocusOwner==""?"active":"")" @onclick="ClearDailyFocus">Team overview</button>@foreach(var person in DailyPeople()){<button class="@(dailyFocusOwner==person.Id?"active":"")" @onclick="()=>FocusDaily(person.Id)"><span>@person.Name</span><small>@person.Open open@if(!dailyActiveOnly&&person.RecentlyClosed>0){<text> · @person.RecentlyClosed closed</text>}</small></button>}</div>
@if(dailyFocusOwner==""){
<div class="people-board-heading compact-daily-heading"><div><h2>Team overview</h2><p>Choose a person to review and reprioritize their work.</p></div><strong>@DailyPeople().Sum(x=>x.Open) open</strong></div>
<div class="daily-team-overview">@foreach(var person in DailyPeople()){var top=DailyOpenFor(person.Id).Take(2).ToArray();<button class="daily-person-summary @(OffToday(person.Id)?"person-off":"")" @onclick="()=>FocusDaily(person.Id)"><header><span><strong>@person.Name</strong>@if(OffToday(person.Id)){<em>Off today</em>}</span><span class="daily-summary-count">@person.Open</span></header><div class="daily-summary-metrics"><span>@person.Open open</span>@if(!dailyActiveOnly){<span>@person.RecentlyClosed recently closed</span>}</div>@if(top.Length==0){<small>No open work in the current filters.</small>}else{<div class="daily-summary-priorities">@foreach(var item in top){<span><b>#@item.Id</b> @DisplayTitle(item)</span>}</div>}<footer>Open person →</footer></button>}</div>
}else{
var focusPerson=meta.People.FirstOrDefault(p=>p.Id==dailyFocusOwner);var openWork=DailyOpenFor(dailyFocusOwner);var recentlyClosed=RecentlyClosedFor(dailyFocusOwner);
<div class="daily-focus-heading"><div><span class="eyebrow">Person focus</span><h2>@(focusPerson?.Name??"Person")</h2><p>@openWork.Count open item@(openWork.Count==1?"":"s")@if(OffToday(dailyFocusOwner)){<text> · Off today</text>}</p></div><div class="daily-focus-nav"><button @onclick="()=>MoveDailyFocus(-1)">←</button><button @onclick="ClearDailyFocus">Team overview</button><button @onclick="()=>MoveDailyFocus(1)">→</button></div></div>
@if(!dailyActiveOnly){<section class="recently-closed-section"><header><div><span class="eyebrow">Recently closed</span><h3>Completed since the last working day</h3></div><small>@RecentClosedSinceLabel</small></header>@if(recentlyClosed.Count==0){<div class="daily-empty-line">Nothing closed in this window.</div>}else{<div class="recently-closed-list">@foreach(var w in recentlyClosed){<button @onclick="()=>OpenDailyPanel(w)"><span class="recently-closed-check">✓</span><span><strong>#@w.Id · @DisplayTitle(w)</strong><small>@w.State · @w.Changed.ToLocalTime().ToString("MMM d, HH:mm")</small></span><span>Open →</span></button>}</div>}</section>}
<section class="daily-open-section"><header><div><span class="eyebrow">Priority order</span><h3>Open work</h3></div><span>@openWork.Count item@(openWork.Count==1?"":"s")</span></header>@if(openWork.Count==0){<div class="daily-empty-line">No open work matches the current filters.</div>}else{<div class="daily-focus-list">@foreach(var w in openWork){<article @key="w.Id" @ondragenter="()=>DailyDragOver(w)" @ondragover:preventDefault @ondrop="()=>DailyDropOn(w)" class="daily-focus-item @(busy.Contains(w.Id)?"saving":"") @(Blocked(w)?"blocked":"") @DailyDropClass(w)"><span class="card-drag-handle @(!CanOrder(w)?"disabled":"")" draggable="@CanOrder(w)" title="@(CanOrder(w)?"Drag to reprioritize":"This item cannot be reordered")" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true" @ondragstart="()=>DailyDragStart(w)" @ondragend="DailyDragEnd" aria-hidden="true">⠿</span><button class="daily-focus-title" title="@w.Title" @onclick="()=>OpenDailyPanel(w)"><span>#@w.Id</span><strong>@DisplayTitle(w)</strong><small>@w.State · @(w.Estimate?.ToString("0.#")??"?") effort</small></button><div class="daily-focus-tags">@foreach(var tag in w.Tags.Take(2)){<span class="tag-chip @(prefs.BlockedTags.Contains(tag,StringComparer.OrdinalIgnoreCase)?"blocked-tag":"")">@(prefs.BlockedTags.Contains(tag,StringComparer.OrdinalIgnoreCase)?"Blocked":tag)</span>}@if(w.Tags.Length>2){<span class="tag-more">+@(w.Tags.Length-2)</span>}</div><div class="daily-focus-actions">@if(DoneState(w) is not null){<button class="done-action" disabled="@busy.Contains(w.Id)" @onclick="()=>MarkDone(w)">✓ Done</button>}@if(w.CommentCount>0){<button @onclick="()=>OpenDailyPanel(w)">💬 @w.CommentCount</button>}<span class="owner-select-control"><span class="owner-avatar" aria-hidden="true">●</span><select aria-label="Assign work item @w.Id" value="@OwnerValue(w)" disabled="@(busy.Contains(w.Id)||drafts.ContainsKey(w.Id))" @onchange="e=>InlineEdit((w,ItemField.Owner,e.Value?.ToString()??string.Empty))"><option value="">Unassigned</option>@foreach(var p in meta.People){<option value="@p.UniqueName">@p.Name</option>}</select><span class="owner-chevron" aria-hidden="true">⌄</span></span></div></article>}</div>}</section>
}
}else{
<WorkGrid Items="Visible" Meta="meta" Columns="WorkspaceColumns" Selected="selected" Busy="busy" Drafts="drafts.Keys.ToHashSet()" TagSuggestions="TagSuggestions" BlockedTags="prefs.BlockedTags" SuggestedTags="SuggestedTags" AcceptTag="AddSuggestedTag" RemoveTag="RemoveTag" DragStart="DragStart" Drop="DropOn" SortedBy="sort" Descending="descending" Sort="Sort" Select="Select" SelectAll="ToggleAll" Open="OpenDetail" OpenParent="OpenById" Edit="InlineEdit"/>
}
@if(SelectedItems.Count>0){<div class="bulk-bar"><strong>@SelectedItems.Count selected</strong><button @onclick='()=>StartBulk("Owner")'>Assign ⌄</button><button @onclick='()=>StartBulk("AddTag")'>+ Tag</button><button @onclick='()=>StartBulk("RemoveTag")'>Remove tag</button><button @onclick='()=>StartBulk("Previous")'>← Sprint</button><button @onclick='()=>StartBulk("Next")'>Sprint →</button><button @onclick='()=>StartBulk("Iteration")'>Choose sprint</button><button @onclick='()=>StartBulk("State")'>State ⌄</button><button @onclick='()=>StartBulk("Area")'>Area</button><button @onclick='()=>StartBulk("Priority")'>Priority</button><button class="smart-fix-trigger" @onclick="PrepareSmartFix">⚡ Smart Fix</button><button @onclick='()=>OpenPrompt(SelectedItems)'>Generate Copilot prompt</button><button @onclick="PasteSelected">Paste AI review</button><button @onclick="selected.Clear">Clear</button></div>}
</section>
}
</main></div>
@if(detail is not null&&meta is not null){var shown=drafts.TryGetValue(detail.Id,out var draft)?ItemChanges.Apply(detail,draft.Changes,meta):detail;var quality=Quality.Evaluate(shown,prefs,AllLoaded);
<aside class="detail-panel" role="dialog" aria-modal="false" aria-label="Work item details"><header><span>#@detail.Id · @detail.Type</span><button aria-label="Close details" @onclick="()=>detail=null">×</button></header><h2>@shown.Title</h2><div class="toolbar"><span class="pill">@detail.State</span><span>@(detail.Owner==""?"Unassigned":detail.Owner)</span></div><p class="muted">@detail.Iteration · revision @detail.Revision</p>
@if(draft is not null){<div class="notice">Local AI draft — Azure DevOps is unchanged.</div><div class="toolbar"><button class="primary" @onclick="()=>ReviewDraft(detail.Id)">Review &amp; update Azure DevOps</button><button @onclick="()=>drafts.Remove(detail.Id)">Discard draft</button></div>}
<h3>Description</h3><pre class="prose">@ContentText.Plain(shown.Description)</pre><h3>Acceptance criteria</h3><pre class="prose">@ContentText.Plain(shown.Acceptance)</pre><div class="tags">@foreach(var tag in shown.Tags){<span class="pill tag-pill">@tag <button type="button" class="tag-remove" aria-label="Remove tag @tag from work item @shown.Id" title="Remove tag" disabled="@(draft is not null||busy.Contains(shown.Id))" @onclick="()=>RemoveTag((shown,tag))">×</button></span>}</div>
@if(detail.Parent is {} parent){<p>Parent <button @onclick="()=>OpenById(parent)">#@parent</button></p>}
<div class="quality"><h3>PBI quality <strong>@quality.Score / 100</strong></h3><p class="muted">Checklist heuristic. Review it in context.</p>@foreach(var check in quality.Checks.Where(c=>c.Weight>0)){<div class="@(check.Passed?"pass":"warn")">@(check.Passed?"✓":"⚠") @check.Name</div>}</div>
<div class="toolbar"><button class="primary" @onclick="()=>OpenPrompt([shown])">Generate Copilot prompt</button><button @onclick="()=>PasteItems([detail])">Paste AI review</button></div>@if(SafeLink(detail.Url)){<a target="_blank" rel="noopener noreferrer" href="@detail.Url">Open in Azure DevOps ↗</a>}
</aside>}
@if(dailyPanelItem is not null&&meta is not null){var panel=dailyPanelItem;
<aside class="daily-side-panel" role="dialog" aria-modal="false" aria-label="Daily work item actions"><header><div><span class="eyebrow">Daily actions</span><strong>#@panel.Id</strong></div><button aria-label="Close daily actions" @onclick="()=>dailyPanelItem=null">×</button></header><h2 title="@panel.Title">@panel.Title</h2><p class="muted">@panel.Type · sprint order @(panel.Order?.ToString("0.##")??"not available")</p>
<div class="daily-panel-fields"><label>Owner<span class="owner-select-control panel-owner-select"><span class="owner-avatar" aria-hidden="true">●</span><select value="@OwnerValue(panel)" disabled="@busy.Contains(panel.Id)" @onchange="ReassignDailyPanel"><option value="">Unassigned</option>@foreach(var p in meta.People){<option value="@p.UniqueName">@p.Name</option>}</select><span class="owner-chevron" aria-hidden="true">⌄</span></span></label><label>Status<select value="@panel.State" disabled="@busy.Contains(panel.Id)" @onchange="ChangeDailyState">@foreach(var state in DailyStates(panel)){<option value="@state.Name">@state.Name</option>}</select></label></div>
<details class="item-description"><summary>Description</summary>@if(string.IsNullOrWhiteSpace(ContentText.Plain(panel.Description))){<p class="muted">No description.</p>}else{<pre class="prose">@ContentText.Plain(panel.Description)</pre>}@if(!string.IsNullOrWhiteSpace(ContentText.Plain(panel.Acceptance))){<h4>Acceptance / testing</h4><pre class="prose">@ContentText.Plain(panel.Acceptance)</pre>}</details>
<div class="daily-panel-section"><div class="daily-panel-heading"><h3>Tags</h3>@if(Blocked(panel)){<span class="blocked-mark">Blocked</span>}</div><div class="tags">@foreach(var tag in panel.Tags){<span class="tag-chip @(prefs.BlockedTags.Contains(tag,StringComparer.OrdinalIgnoreCase)?"blocked-tag":"")">@tag <button class="tag-remove" @onclick="()=>RemoveDailyPanelTag(tag)">×</button></span>}</div>@if(SuggestedTags(panel).Length>0){<div class="daily-tag-suggestions"><span>Suggestions</span>@foreach(var tag in SuggestedTags(panel)){<button class="tag-suggestion" disabled="@busy.Contains(panel.Id)" @onclick="async()=>{await AddSuggestedTag((panel,tag));dailyPanelItem=items.FirstOrDefault(x=>x.Id==panel.Id)??panel;}">+ @tag</button>}</div>}<div class="daily-panel-add"><input list="daily-panel-tags" placeholder="Add tag…" @bind="dailyTagText"/><datalist id="daily-panel-tags">@foreach(var tag in TagSuggestions){<option value="@tag"></option>}</datalist><button disabled="@string.IsNullOrWhiteSpace(dailyTagText)" @onclick="AddDailyTag">Add</button></div></div>
<div class="daily-panel-section"><div class="daily-panel-heading"><h3>Comments</h3><span>@panel.CommentCount</span></div>@if(dailyPanelLoading){<p class="muted">Loading comments…</p>}else if(dailyComments.Count==0){<p class="muted">No comments yet.</p>}else{<div class="daily-comments">@foreach(var comment in dailyComments.TakeLast(20).Reverse()){<article><header><strong>@comment.Author</strong><small>@comment.Created.ToLocalTime().ToString("MMM d, HH:mm")</small></header><p>@ContentText.Plain(comment.Text)</p></article>}</div>}<textarea rows="3" placeholder="Add a comment to the PBI…" @bind="dailyCommentText"></textarea><button class="primary" disabled="@string.IsNullOrWhiteSpace(dailyCommentText)" @onclick="AddDailyComment">Add comment</button></div>
<div class="daily-panel-footer">@if(SafeLink(panel.Url)){<a target="_blank" rel="noopener noreferrer" href="@panel.Url">Open in Azure DevOps ↗</a>}</div></aside>}
@if(dialog!=""){
<div class="scrim"><section class="dialog @(dialog is "ai" or "review" or "prompt" or "smartorder" or "smartfix" or "magic"?"wide":"")" role="dialog" aria-modal="true" aria-labelledby="dialog-title"><header><h2 id="dialog-title">@DialogTitle</h2><button disabled="@applying" aria-label="Close dialog" @onclick="CloseDialog">×</button></header>
@if(dialog=="palette") {<input autofocus aria-label="Find command" placeholder="Type a command…" @bind="commandSearch" @bind:event="oninput"/><div class="command-list">@foreach(var command in Commands.Where(c=>c.Contains(commandSearch,StringComparison.OrdinalIgnoreCase))){<button @onclick="()=>RunCommand(command)">@command</button>}</div>}
else if(dialog=="iterations") {<input aria-label="Search iterations" placeholder="Find sprint…" @bind="iterationSearch" @bind:event="oninput"/>@foreach(var i in meta!.Iterations.Where(i=>i.Path.Contains(iterationSearch,StringComparison.OrdinalIgnoreCase))){<button class="list-option" @onclick="()=>ChooseSprint(i)">@i.Name <small>@i.Path</small></button>}}
else if(dialog=="columns") {<p>ID and title stay visible.</p>@foreach(var c in AllColumns){<label class="checkbox"><input type="checkbox" checked="@prefs.Columns.Contains(c)" disabled="@(c is "ID" or "Title")" @onchange="()=>ToggleColumn(c)"/>@c</label>}}
else if(dialog=="saveview") {<label>View name<input @bind="viewName"/></label><button class="primary" @onclick="SaveView">Save view</button>}
else if(dialog=="smartorder") {<p>Smart Order will write the real Azure DevOps sprint order. Items are grouped by owner, then <strong>Done → Blocked → Active</strong>. Existing Azure DevOps order is preserved inside each group.</p><div class="smart-order-preview">@foreach(var ownerGroup in smartOrderPlan.GroupBy(x=>x.Owner)){<section><header><strong>@ownerGroup.Key</strong><span>@ownerGroup.Count() items</span></header>@foreach(var group in ownerGroup.GroupBy(x=>x.Group)){<div class="smart-order-group"><span class="smart-order-group-label @group.Key.ToLowerInvariant()">@group.Key</span>@foreach(var row in group){<div class="smart-order-row"><em>@row.Position</em><span>#@row.Item.Id · @row.Item.Title</span><small>@(row.Item.Order?.ToString("0.##")??"no current order")</small></div>}</div>}</section>}</div><div class="toolbar"><button disabled="@smartOrdering" @onclick="CloseDialog">Cancel</button><button class="primary" disabled="@smartOrdering" @onclick="ApplySmartOrder">@(smartOrdering?"Applying…":"Apply to Azure DevOps")</button></div>}
else if(dialog=="smartfix") {
<p>Smart Fix only targets missing <strong>application tags</strong>, missing estimates, and missing tags on the selected items. Initiative tags are optional and are never treated as missing. Estimates use the available work-item context; when Copilot cannot derive one, SprintPilot proposes the 3h default. Nothing is written to Azure DevOps until you review and apply the final diff.</p>
@if(smartFixSuggestions.Count==0){
<div class="smart-fix-gaps">@foreach(var gap in smartFixGaps){<article><header><strong>#@gap.Item.Id · @gap.Item.Title</strong><span>@SmartFixNeeds(gap)</span></header><div class="tags">@foreach(var tag in gap.Item.Tags){<span class="tag-chip">@tag</span>}@if(gap.Item.Tags.Length==0){<small>No current tags</small>}</div><details class="item-description compact"><summary>Description</summary>@if(string.IsNullOrWhiteSpace(ContentText.Plain(gap.Item.Description))){<p class="muted">No description.</p>}else{<pre class="prose">@ContentText.Plain(gap.Item.Description)</pre>}</details></article>}</div>
<label>Prompt for Copilot<textarea class="prompt-editor" rows="14" @bind="smartFixPrompt"></textarea></label>
<div class="toolbar smart-fix-actions"><button @onclick="CloseDialog">Cancel</button><button class="primary" @onclick="CopySmartFixPrompt">Copy prompt for Copilot</button></div>
<label>Paste Copilot JSON<textarea rows="12" @bind="smartFixCopilotText" placeholder="Paste Copilot's raw JSON response here…"></textarea></label>
<button class="primary" disabled="@string.IsNullOrWhiteSpace(smartFixCopilotText)" @onclick="ParseSmartFixCopilot">Import suggestions</button>
}else{
<div class="smart-fix-suggestions">@foreach(var suggestion in smartFixSuggestions){var gap=smartFixGaps.First(g=>g.Item.Id==suggestion.Id);<article><header><div><strong>#@suggestion.Id · @gap.Item.Title</strong>@if(suggestion.Reason!=""){<small>@suggestion.Reason</small>}</div><span>Choose what to apply</span></header><details class="item-description compact"><summary>Description</summary>@if(string.IsNullOrWhiteSpace(ContentText.Plain(gap.Item.Description))){<p class="muted">No description.</p>}else{<pre class="prose">@ContentText.Plain(gap.Item.Description)</pre>}</details><div class="smart-fix-options">@if(suggestion.ApplicationTag!=""){<label class="smart-fix-option"><input type="checkbox" @bind="suggestion.ApplyApplication"/><span><strong>Application tag</strong><small>@suggestion.ApplicationTag</small></span></label>}@if(suggestion.Estimate is not null){<label class="smart-fix-option"><input type="checkbox" @bind="suggestion.ApplyEstimate"/><span><strong>Estimate</strong><small>@suggestion.Estimate.Value.ToString("0.##")</small></span></label>}@if(suggestion.AddTags.Length>0){<label class="smart-fix-option"><input type="checkbox" @bind="suggestion.ApplyTags"/><span><strong>Add tags</strong><small>@string.Join("; ",suggestion.AddTags)</small></span></label>}</div></article>}</div>
<div class="toolbar smart-fix-actions"><button @onclick="()=>smartFixSuggestions=[]">Back to Copilot result</button><button class="primary" @onclick="ReviewSmartFix">Review selected changes</button></div>
}}
else if(dialog=="magic") {
<p>Magic Orchestration proposes <strong>owner changes only</strong>. SprintPilot pre-filters the candidate people using current-sprint capacity, estimates, application continuity and time off; Copilot can only choose from those candidates. No reassignment is written until you explicitly accept it and pass the final Azure DevOps review.</p>
@if(magicSuggestions.Count==0){
<div class="magic-context-list">@foreach(var context in magicContexts.Take(12)){<article><header><div><strong>#@context.Item.Id · @context.Item.Title</strong><small>@context.CurrentOwnerName · @context.CurrentPercent% load · @context.Estimate.ToString("0.##")h</small></div><span>@context.Candidates.Length candidates</span></header><div class="magic-candidate-chips">@foreach(var candidate in context.Candidates){<span>@candidate.Name · @candidate.CurrentPercent% → @candidate.ProjectedPercent%@if(candidate.SameApplicationItems>0){<em>same app</em>}</span>}</div><details class="item-description compact"><summary>Description</summary>@if(string.IsNullOrWhiteSpace(ContentText.Plain(context.Item.Description))){<p class="muted">No description.</p>}else{<pre class="prose">@ContentText.Plain(context.Item.Description)</pre>}</details></article>}</div>
<label>Prompt for Copilot<textarea class="prompt-editor" rows="18" @bind="magicPrompt"></textarea></label>
<div class="toolbar magic-actions"><button @onclick="CloseDialog">Cancel</button><button class="primary" @onclick="CopyMagicPrompt">Copy prompt for Copilot</button></div>
<label>Paste Copilot JSON<textarea rows="12" @bind="magicCopilotText" placeholder="Paste Copilot's raw JSON response here…"></textarea></label>
<button class="primary" disabled="@string.IsNullOrWhiteSpace(magicCopilotText)" @onclick="ParseMagicCopilot">Import recommendations</button>
}else{
<div class="magic-suggestions">@foreach(var suggestion in magicSuggestions){var context=MagicContextFor(suggestion.Id);var target=MagicTarget(suggestion);<article class="@suggestion.Decision"><header><div><strong>#@suggestion.Id · @context.Item.Title</strong><small>@context.CurrentOwnerName → @target.Name</small></div><span class="magic-confidence @suggestion.Confidence.ToLowerInvariant()">@suggestion.Confidence confidence</span></header><div class="magic-impact"><span><small>@context.CurrentOwnerName</small><strong>@context.CurrentPercent% → @context.SourceProjectedPercent%</strong></span><span>→</span><span><small>@target.Name</small><strong>@target.CurrentPercent% → @target.ProjectedPercent%</strong></span></div>@if(suggestion.Reason!=""){<p class="magic-reason">@suggestion.Reason</p>}<details class="item-description compact"><summary>Description</summary>@if(string.IsNullOrWhiteSpace(ContentText.Plain(context.Item.Description))){<p class="muted">No description.</p>}else{<pre class="prose">@ContentText.Plain(context.Item.Description)</pre>}@if(!string.IsNullOrWhiteSpace(ContentText.Plain(context.Item.Acceptance))){<h4>Acceptance / testing</h4><pre class="prose">@ContentText.Plain(context.Item.Acceptance)</pre>}</details><div class="magic-decision"><button class="accept @(suggestion.Decision=="accepted"?"active":"")" @onclick='()=>DecideMagic(suggestion,"accepted")'>✓ Accept</button><button class="ignore @(suggestion.Decision=="ignored"?"active":"")" @onclick='()=>DecideMagic(suggestion,"ignored")'>Ignore</button></div></article>}</div>
@if(MagicProjection().Count>0){<section class="magic-projection"><header><strong>Projected load after accepted moves</strong><span>@magicSuggestions.Count(s=>s.Decision=="accepted") accepted</span></header>@foreach(var row in MagicProjection()){<div><span>@row.Name</span><strong class="@(row.After>100?"over":"")">@row.Before% → @row.After%</strong></div>}</section>}
<div class="toolbar magic-actions"><span class="muted">@magicSuggestions.Count(s=>s.Decision=="pending") pending · @magicSuggestions.Count(s=>s.Decision=="accepted") accepted · @magicSuggestions.Count(s=>s.Decision=="ignored") ignored</span><button @onclick="()=>magicSuggestions=[]">Back to Copilot result</button><button class="primary" disabled="@(!magicSuggestions.Any(s=>s.Decision=="accepted")||magicSuggestions.Any(s=>s.Decision=="pending"))" @onclick="ReviewMagicOrchestration">Review accepted reassignments</button></div>
}}
else if(dialog=="bulk") {
<p>@SelectedItems.Count visible selected item(s). Hidden rows are never included in this action.</p><label>@BulkLabel
@if(bulkKind=="Owner"){<select @bind="bulkValue"><option value="">Unassigned</option>@foreach(var p in meta!.People){<option value="@p.UniqueName">@p.Name</option>}</select>}
else if(bulkKind=="State"){<select @bind="bulkValue"><option value="">Choose state…</option>@foreach(var s in CommonStates){<option>@s</option>}</select>}
else if(bulkKind is "Iteration" or "Next" or "Previous"){<select @bind="bulkValue"><option value="">Choose sprint…</option>@foreach(var i in meta!.Iterations){<option value="@i.Path">@i.Name</option>}</select>}
else if(bulkKind=="Area"){<select @bind="bulkValue"><option value="">Choose area…</option>@foreach(var a in meta!.Areas){<option>@a</option>}</select>}
else {<input @bind="bulkValue" placeholder="@(bulkKind=="Priority"?"1–4":"Tag")"/>}</label><button class="primary" @onclick="PreviewBulk">Review changes</button>}
else if(dialog=="review") {
<p>@pending.Count work items will be changed. Every update checks the original revision.</p><div class="review-scroll">@foreach(var u in pending){<article class="review-item"><h3>#@u.Original.Id — @u.Original.Title</h3><details class="item-description compact"><summary>Description</summary>@if(string.IsNullOrWhiteSpace(ContentText.Plain(u.Original.Description))){<p class="muted">No description.</p>}else{<pre class="prose">@ContentText.Plain(u.Original.Description)</pre>}</details><table class="diff"><thead><tr><th>Field</th><th>Current</th><th>Proposed</th></tr></thead><tbody>@foreach(var c in u.Changes){<tr><th>@c.Field</th><td><pre>@Display(u.Original,c.Field)</pre></td><td><pre>@ContentText.Plain(c.Value?.ToString()??"(empty)")</pre></td></tr>}</tbody></table></article>}</div>
@if(results.Count>0){<div class="notice" role="status">✓ @results.Count(r=>r.Success) updated · ⚠ @results.Count(r=>!r.Success) failed</div>@foreach(var failure in results.Where(r=>!r.Success)){<p class="error-text">#@failure.Id — @failure.Error</p>}}
<div class="toolbar"><button disabled="@applying" @onclick="CloseDialog">@(results.Count>0?"Close":"Cancel")</button>@if(results.Count==0){<button class="primary" disabled="@applying" @onclick="ApplyPending">@(applying?"Updating…":$"Apply {pending.Count} changes")</button>}else if(results.Any(r=>!r.Success)){<button class="primary" disabled="@applying" @onclick="RetryFailed">Refresh failed &amp; review retry</button>}</div>}
else if(dialog=="ai") {
@if(reviews.Length==0){<p>Paste the complete standardized response for @aiItems.Length item(s).</p><textarea aria-label="AI review response" rows="16" @bind="aiText"></textarea><button class="primary" @onclick="ParseAi">Preview review</button>}
else {<div class="review-scroll">@foreach(var review in reviews){var original=aiItems.Single(w=>w.Id==review.Id);<article class="review-item"><h3>#@review.Id — @original.Title</h3>@foreach(var c in ReviewChanges(review)){<h4>@c.Field</h4><div class="diff-pair"><div><small>Current</small><pre>@Display(original,c.Field)</pre></div><div><small>Proposed</small><pre>@ContentText.Plain(c.Value?.ToString()??"")</pre></div></div>}<h4>Questions / missing information</h4><pre class="prose">@review.Sections["QUESTIONS / MISSING INFORMATION"]</pre></article>}</div><div class="toolbar"><button @onclick="()=>reviews=[]">Back</button><button @onclick="ApplyAiLocally">Apply locally</button><button class="primary" @onclick="ReviewAiServer">Review Azure DevOps update</button></div>}}
else if(dialog=="prompt") {
<p>Review or adjust this prompt, then copy it into Copilot. SprintPilot will not change Azure DevOps from this screen.</p><textarea class="prompt-editor" aria-label="Copilot prompt" rows="24" @bind="promptText"></textarea><div class="toolbar"><button @onclick="CloseDialog">Cancel</button><button class="primary" @onclick="CopyPrompt">Copy to clipboard</button></div>
}
else if(dialog=="create") {
<label>Work-item type<select @bind="newType">@foreach(var t in meta!.Types){<option>@t.Name</option>}</select></label><label>Template<select @onchange="ApplyCreateTemplate"><option value="">Blank</option>@for(int i=0;i<prefs.Templates.Count;i++){<option value="@i">@prefs.Templates[i].Name</option>}</select></label><label>Title<input @bind="newTitle"/></label><label>Description<textarea rows="5" @bind="newDescription"></textarea></label><label>Acceptance criteria / testing<textarea rows="4" @bind="newAcceptance"></textarea></label>@if(!meta!.Types.First(t=>t.Name==newType).Fields.Contains("Microsoft.VSTS.Common.AcceptanceCriteria")){<p class="muted">This type has no acceptance-criteria field. These criteria will be included in its description.</p>}<label>Area<select @bind="newArea">@foreach(var a in meta!.Areas){<option>@a</option>}</select></label><label>Sprint<select @bind="newIteration">@foreach(var i in meta!.Iterations){<option value="@i.Path">@i.Name</option>}</select></label><label>Parent ID (optional)<input type="number" min="1" @bind="newParent"/></label><label>Tags<input @bind="newTags"/></label><button class="primary" disabled="@applying" @onclick="CreateItem">@(applying?"Creating…":"Create work item")</button>
}
@if(dialogError!=""){<p class="error-text" role="alert">@dialogError</p>}
</section></div>}
<div id="blazor-error-ui">SprintPilot lost its connection. <a href="/">Reload</a> to reconnect; refresh work items before retrying a change.</div>
