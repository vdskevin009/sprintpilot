@page "/"
@implements IAsyncDisposable
@inject TrackerSession Tracker
@inject ICredentialStore Credentials
@inject IPreferencesStore Preferences
@inject BulkEditor Bulk
@inject IJSRuntime JS

<div class="app-shell">
<aside class="rail"><a class="brand" href="/" aria-label="SprintPilot home"><img src="icon.svg" alt=""/><span><strong>SprintPilot</strong><small>KV Solutions</small></span></a>
<div class="workspace-label">Orchestration</div>
<button class="nav-button @(screen=="home"?"active":"")" disabled="@(meta is null)" @onclick='()=>SetScreen("home")'>⌂ Home</button>
<button class="nav-button @(screen=="meeting"?"active":"")" disabled="@(meta is null)" @onclick='()=>SetScreen("meeting")'>✎ Meetings</button>
<div class="workspace-label">Workspace</div>
<button class="nav-button @(screen=="workspace"?"active":"")" disabled="@(meta is null)" @onclick='()=>SetScreen("workspace")'>▦ Sprint workspace</button>
<button class="nav-button @(screen=="cleanup"?"active":"")" disabled="@(meta is null)" @onclick="OpenCleanup">◷ Sprint cleanup</button>
<button class="nav-button @(screen=="branches"?"active":"")" disabled="@(meta is null)" @onclick="OpenBranchCleanup">⎇ Branch review</button>
<a class="nav-button nav-link-button" href="/environments">▥ Environments</a>
<a class="nav-button nav-link-button" href="/pipeline-factory">⚙ Pipeline factory</a>
<button class="nav-button @(screen=="pullrequests"?"active":"")" disabled="@(meta is null)" @onclick="OpenPullRequestCleanup">⇄ PR review</button>
<div class="workspace-label">Saved views <button title="Save current view" disabled="@(meta is null)" @onclick='()=>Show("saveview")'>+</button></div>
@foreach(var view in prefs.Views){<button class="nav-button" @onclick="()=>LoadView(view)">⌑ @view.Name</button>}
<div class="rail-bottom"><button class="nav-button" @onclick='()=>SetScreen("settings")'>⚙ Settings</button><button class="nav-button" title="Command palette (Ctrl+K)" @onclick='()=>Show("palette")'>⌘ Commands <kbd>Ctrl K</kbd></button><div class="connection-dot">● @(Tracker.Demo?"Demo workspace":meta is null?"Not connected":"Azure DevOps connected")</div></div></aside>
<main>
<header class="topbar"><span class="topbar-context">@(Tracker.Demo?"Demo / Platform team":connection is null?"Local workspace":connection.Organization+" / "+connection.Project)</span><span class="topbar-product">KV Solutions <i>·</i> SprintPilot</span><span class="muted">@meta?.Me.Name</span></header>
@if(Tracker.Demo){<div class="demo-banner">Demo mode — changes stay in this browser session. <button @onclick="ExitDemo">Connect Azure DevOps</button></div>}
@if(message!=""){<div class="notice @(hasError?"error":"")" role="status">@message <button aria-label="Dismiss notification" @onclick="()=>message=string.Empty">×</button></div>}
@if(initializing){<div class="empty"><h1>Opening SprintPilot…</h1></div>}
else if(screen=="settings"){
<section class="settings"><div class="page-heading"><div><h1>Settings</h1><p>Make SprintPilot work the way you do.</p></div><button class="primary" @onclick="SaveSettings">Save settings</button></div>
<h2>Appearance</h2><label>Theme<select @bind="prefs.Theme" @bind:after="SaveTheme"><option value="system">System</option><option value="dark">Dark</option><option value="light">Light</option><option value="avd">AVD friendly</option></select><small>Your theme is saved automatically, including after updates. AVD friendly uses light solid surfaces, stronger borders, and minimal visual effects to reduce remote-desktop compression artifacts.</small></label>
<h2>Connection</h2><p>@(connection?.Organization??"No organization") / @(connection?.Project??"No project")</p><button @onclick="ChangeConnection">Change connection</button>
@if(meta is not null&&!Tracker.Demo){<label>Team<select value="@connection?.Team" @onchange="ChangeTeam">@foreach(var t in meta.Teams){<option value="@t.Id">@t.Name</option>}</select></label>}
<h2>Repository monitoring</h2><p>Review-only signals for the connected Azure DevOps project. SprintPilot surfaces stale pull requests, merged branches that remain, and old branches without a pull request; it never changes repository state automatically.</p><label class="checkbox"><input type="checkbox" @bind="prefs.RepositoryMonitoringEnabled"/>Show repository signals in Home · Needs attention</label><div class="repository-monitor-settings"><label>Branch stale threshold (days)<input type="number" min="30" max="365" @bind="prefs.BranchCleanupStaleDays"/></label><label>PR stale threshold (days)<input type="number" min="30" max="365" @bind="prefs.PullRequestCleanupStaleDays"/></label></div>@if(repositoryMonitoringError!=""){<p class="muted">Last scan: @repositoryMonitoringError</p>}
<h2>Blocked work</h2><p>Work items with any of these Azure DevOps tags are shown as Blocked everywhere in SprintPilot.</p><label>Blocked tags (one per line)<textarea rows="5" @bind="blockedTagsText"></textarea></label>
<h2>Public holidays</h2><p>Belgium, Canada, Québec, Poland, Czechia and Germany are always available in Home and Sprint Daily. SprintPilot refreshes them online when possible and falls back to its built-in calendar when the network is unavailable.</p>@if(holidayCalendarError!=""){<p class="muted">@holidayCalendarError</p>}
<h2>Applications &amp; initiatives</h2><p>These classifications stay local to SprintPilot. The Azure DevOps tags themselves are not changed.</p>
<div class="toolbar"><input list="settings-known-tags" placeholder="Add a tag to classify…" @bind="classificationTag"/><datalist id="settings-known-tags">@foreach(var known in KnownPlanningTags){<option value="@known"></option>}</datalist><button @onclick="AddClassification">Add classification</button></div>
@if(PlanningPrefs.Tags.Count>0){<div class="settings-tag-grid">@foreach(var tag in PlanningPrefs.Tags.ToArray()){<div class="settings-tag-row"><strong>@tag.Tag</strong><label class="checkbox"><input type="checkbox" checked="@tag.Application" @onchange="e=>SetClassification(tag.Tag,true,e.Value is true)"/>Application</label><label class="checkbox scope-setting"><input type="checkbox" disabled="@(!tag.Application)" checked="@tag.ApplicationMyScope" @onchange="e=>SetClassificationScope(tag.Tag,true,e.Value is true)"/>My Scope</label><label class="checkbox"><input type="checkbox" checked="@tag.Initiative" @onchange="e=>SetClassification(tag.Tag,false,e.Value is true)"/>Initiative</label><label class="checkbox scope-setting"><input type="checkbox" disabled="@(!tag.Initiative)" checked="@tag.InitiativeMyScope" @onchange="e=>SetClassificationScope(tag.Tag,false,e.Value is true)"/>My Scope</label><button class="text-button" @onclick="()=>RemoveClassification(tag.Tag)">Remove</button></div>}</div>}
@if(PlanningPrefs.Tags.Any(t=>t.Initiative)){<h3>Initiative orchestration</h3><p>Due date, status, confidence and notes are local SprintPilot metadata.</p><div class="initiative-settings">@foreach(var tag in PlanningPrefs.Tags.Where(t=>t.Initiative).ToArray()){var initiative=Initiative(tag.Tag);<div class="initiative-setting-row"><strong>@tag.Tag</strong><label>Due date<input type="date" value="@(initiative.DueDate?.ToString("yyyy-MM-dd")??"")" @onchange="e=>SetInitiativeDueDate(tag.Tag,e)"/></label><label>Status<select value="@initiative.Status" @onchange="e=>SetInitiativeStatus(tag.Tag,e)"><option>Ongoing</option><option>On Track</option><option>At Risk</option><option>Blocked</option></select></label><label>Confidence<select value="@initiative.Confidence" @onchange="e=>SetInitiativeConfidence(tag.Tag,e)"><option>High</option><option>Medium</option><option>Low</option></select></label><label class="initiative-note">Comment<input value="@initiative.Comment" @onchange="e=>SetInitiativeComment(tag.Tag,e)" placeholder="Short orchestration note"/></label></div>}</div>}
<h3>Capacity</h3><p>Capacity defaults to 60 hours per sprint. On a standard 10-working-day sprint that is 6 hours per day. Home shows remaining work against remaining time, prorates the sprint as days pass, and removes Azure DevOps days off plus the public-holiday calendar assigned to each person.</p>
<div class="capacity-settings"><label>Default sprint capacity (h)<input type="number" min="0" step="0.5" value="@PlanningPrefs.DefaultTarget.Maximum" @onchange="SetDefaultCapacityHours"/></label></div>
<label class="checkbox"><input type="checkbox" checked="@PlanningPrefs.EstimatesAreHours" @onchange="SetPlanningHours"/>Treat configured estimates as hours</label>
@if(meta is not null){<div class="capacity-overrides"><div class="capacity-overrides-head"><strong>People</strong><span>Default capacity and public-holiday calendars</span></div>@foreach(var person in meta.People){<div class="capacity-override-row capacity-person-setting"><strong>@person.Name</strong><label>Capacity / sprint (h)<input type="number" min="0" step="0.5" value="@PersonCapacityHours(person.Id)" @onchange="e=>SetPersonCapacityHours(person.Id,e)"/></label><div class="person-holiday-calendars"><span>Public holidays</span><div class="holiday-calendar-options">@foreach(var country in HolidayCountries){<label class="checkbox"><input type="checkbox" checked="@HasHolidayCalendar(person.Id,country.Code)" @onchange="e=>TogglePersonHolidayCalendar(person.Id,country.Code,e.Value is true)"/>@country.Name</label>}</div></div>@if(HasPersonCapacityHours(person.Id)){<button class="text-button" @onclick="()=>ClearPersonCapacityHours(person.Id)">Use 60h default</button>}</div>}</div>}
<h2>AI review</h2><p>Copy prompts into your chosen AI tool, then paste its structured response back here.</p><label>Master instructions<textarea rows="14" @bind="prefs.AiPrompt"></textarea></label><button @onclick="()=>prefs.AiPrompt=AiReview.DefaultPrompt">Restore default prompt</button>
<h2>Attention rules</h2><label>Flag sprint work as stagnating after this many days<input type="number" min="1" @bind="prefs.StaleDays"/></label>
<h2>Work-item templates</h2><div class="toolbar"><select aria-label="Template to edit" @bind="templateIndex" @bind:after="LoadTemplate">@for(int i=0;i<prefs.Templates.Count;i++){<option value="@i">@prefs.Templates[i].Name</option>}</select><button @onclick="NewTemplate">+ Template</button><button @onclick="DeleteTemplate">Delete</button></div>
<label>Name<input @bind="templateName"/></label><label>Description<textarea rows="5" @bind="templateDescription"></textarea></label><label>Acceptance criteria / testing<textarea rows="4" @bind="templateAcceptance"></textarea></label><label>Tags<input @bind="templateTags"/></label><label>Area<input @bind="templateArea"/></label><button @onclick="SaveTemplate">Update template</button>
<h2>Saved views</h2>@foreach(var v in prefs.Views.ToArray()){<div class="toolbar">@v.Name<button @onclick="()=>DeleteView(v)">Delete</button></div>}
</section>
}
else if(meta is null){
<section class="welcome"><img src="icon.svg" alt=""/><h1>Welcome to SprintPilot</h1><p>Azure DevOps connection required.</p>
<label>Organization<input placeholder="your-organization" @bind="organization" @bind:after="ResetTest"/></label><label>Project<input placeholder="Your project" @bind="project" @bind:after="ResetTest"/></label><label>Token<input id="pat" type="password" autocomplete="off" @oninput="TokenInput"/></label>
<p class="muted">The token stays on this machine. On Windows, local saving uses Credential Manager.</p>
<div class="toolbar"><button disabled="@connecting" @onclick="TestConnection">Test connection</button><button class="primary" disabled="@connecting" @onclick="SaveConnection">Save locally</button></div>
@if(testUser is not null){<p class="success">✓ Connected as @testUser.Name</p>}
<button class="text-button" @onclick="ExploreDemo">Explore with demo data</button></section>
}
else if(screen=="home"){
<section class="orchestration-home">
<div class="page-heading home-heading"><div><div class="heading-context">@meta.Teams.FirstOrDefault(t=>t.Id==connection?.Team)?.Name · @CurrentSprint?.Name</div><h1>Home</h1><p>Orchestrate what still needs attention. Completed work stays out of the way.</p></div><div class="toolbar home-actions"><label class="scope-toggle" title="Limit scope-aware dashboard sections to applications and initiatives marked My Scope"><input type="checkbox" checked="@prefs.MyScopeOnly" @onchange="ToggleMyScopeOnly"/>My Scope</label>@if(!pwaInstalled){<button class="install-app-button @(pwaInstallAvailable?"ready":"")" title="Install SprintPilot as a Progressive Web App" @onclick="InstallPwa">⊕ Install app</button>}@if(appUpdateChecking){<button disabled>Checking update…</button>}else if(appUpdateAvailable&&appUpdateSupported){<button class="update-app-button" title="@appUpdateText" disabled="@appUpdating" @onclick="StartAppUpdate">@(appUpdating?"Updating…":"↑ Update")</button>}<button class="magic-orchestration-trigger" disabled="@loading" @onclick="PrepareMagicOrchestration">✨ Magic Orchestration</button><button disabled="@loading" @onclick="Refresh">↻ Refresh</button><button @onclick='()=>SetWorkspaceMode("Daily")'>Open Sprint Daily →</button></div></div>
<section class="home-card quick-add-pbi-card" aria-label="Quick add PBI">
<header><div><span class="eyebrow">Quick add</span><h2>New PBI</h2></div>@if(quickPbiCreatedId is not null){<span class="quick-add-created">✓ #@quickPbiCreatedId created</span>}</header>
<div class="quick-add-pbi-form">
<label class="quick-add-title"><span>Title</span><input maxlength="255" placeholder="What needs to be done?" value="@quickPbiTitle" @oninput="QuickPbiTitleChanged" disabled="@quickPbiCreating"/></label>
<label><span>Owner</span><select value="@quickPbiOwner" @onchange="QuickPbiOwnerChanged" disabled="@quickPbiCreating"><option value="">Unassigned</option>@foreach(var person in meta.People){<option value="@person.UniqueName">@person.Name</option>}</select></label>
<label><span>Application</span><select value="@quickPbiApplication" @onchange="QuickPbiApplicationChanged" disabled="@quickPbiCreating"><option value="">@(string.IsNullOrWhiteSpace(quickPbiTitle)?"Choose application":"No confident suggestion")</option>@foreach(var app in ApplicationTags()){<option value="@app">@app</option>}</select></label>
<label><span>Sprint</span><select value="@QuickPbiIterationPath" @onchange="QuickPbiSprintChanged" disabled="@quickPbiCreating">@foreach(var sprint in meta.Iterations){<option value="@sprint.Path">@sprint.Name</option>}</select></label>
<button class="primary quick-add-submit" disabled="@(quickPbiCreating||string.IsNullOrWhiteSpace(quickPbiTitle)||string.IsNullOrWhiteSpace(QuickPbiIterationPath))" @onclick="CreateQuickPbi">@(quickPbiCreating?"Creating…":"+ Add PBI")</button>
</div>
@if(quickPbiError!=""){<p class="quick-add-error">@quickPbiError</p>}
</section>
<PipelineApprovals @ref="pipelineApprovals" @key="connection?.Organization" Organization="@(connection?.Organization??"demo")" Project="@(connection?.Project??"SprintPilot")"/>
<PullRequestStatus @key="prefs.MyScopeOnly" Project="@(connection?.Project??"SprintPilot")" MyScopeOnly="prefs.MyScopeOnly" ScopeApplications="MyScopeApplications()"/>
<div class="home-layout">
<section class="home-card attention-card"><header><div><span class="eyebrow">Now</span><h2>Needs attention</h2></div><span class="home-card-count">@HomeAttention().Sum(x=>x.Count)</span></header>
@if(repositoryMonitoringLoading){<div class="repository-monitor-status">Reviewing project repositories…</div>}else if(repositoryMonitoringError!=""){<div class="repository-monitor-status muted">Repository scan partial · @repositoryMonitoringError</div>}
@if(HomeAttention().Count==0){<div class="home-empty">Nothing urgent in the current sprint.</div>}else{<div class="attention-list">@foreach(var row in HomeAttention()){<button @onclick="()=>OpenAttention(row.Key)"><span class="attention-number">@row.Count</span><span><strong>@row.Label</strong><small>@row.Hint</small></span><span>→</span></button>}</div>}</section>
<div class="capacity-comparison"><section class="home-card capacity-card sprint-capacity-card"><header><div><span class="eyebrow">Current sprint</span><h2>@(CurrentSprint?.Name??"Current sprint")</h2></div><div class="home-card-header-actions"><button class="text-button" disabled="@(NextSprint is null)" @onclick="OpenMoveNextModal">Move to next sprint →</button><span class="home-card-count">@CapacityRowsFor(CurrentSprint).Sum(x=>x.Count)</span></div></header>@if(!PlanningPrefs.EstimatesAreHours){<div class="capacity-note">Capacity is ready; enable “Treat configured estimates as hours” in Settings to compare remaining estimates with it.</div>}<div class="capacity-list">@foreach(var person in CapacityRowsFor(CurrentSprint)){<button @onclick="()=>OpenPerson(person.Id)"><span class="capacity-person"><strong>@person.Name</strong><small>@person.Count @(person.Count==1?"item":"items") · @person.Effort.ToString("0.#")h work / @person.CapacityHours.ToString("0.#")h available</small></span><span class="mini-meter capacity-meter @(person.Percent>100?"over":person.Percent>=85?"near":"")" title="@CapacityMeterTitle(person)" aria-label="@CapacityMeterTitle(person)"><i class="capacity-fill" style="@($"width:{CapacityFillPercent(person)}%")"></i>@if(person.Percent>100){<i class="capacity-overage" style="@($"width:{CapacityOveragePercent(person)}%")"></i>}</span><span class="capacity-state @person.Status.ToLowerInvariant().Replace(" ","-")"><strong>@person.Status</strong><small>@CapacityLoadText(person)</small></span>@if(person.MissingEstimates>0){<small class="missing-estimate">@person.MissingEstimates not estimated</small>}<small class="capacity-baseline">@CapacityBaselineText(person.Id,CurrentSprint)</small>@if(person.NextLeave is not null){<small class="capacity-leave">Next off · @RangeText(person.NextLeave)</small>}</button>}</div></section>
<section class="home-card capacity-card sprint-capacity-card"><header><div><span class="eyebrow">Next sprint</span><h2>@(NextSprint?.Name??"Not configured")</h2></div><span class="home-card-count">@CapacityRowsFor(NextSprint).Sum(x=>x.Count)</span></header>@if(NextSprint is null){<div class="home-empty">No next sprint is configured.</div>}else{<div class="capacity-list">@foreach(var person in CapacityRowsFor(NextSprint)){<button @onclick="()=>OpenSprintPerson(NextSprint!,person.Id)"><span class="capacity-person"><strong>@person.Name</strong><small>@person.Count @(person.Count==1?"item":"items") · @person.Effort.ToString("0.#")h work / @person.CapacityHours.ToString("0.#")h available</small></span><span class="mini-meter capacity-meter @(person.Percent>100?"over":person.Percent>=85?"near":"")" title="@CapacityMeterTitle(person)" aria-label="@CapacityMeterTitle(person)"><i class="capacity-fill" style="@($"width:{CapacityFillPercent(person)}%")"></i>@if(person.Percent>100){<i class="capacity-overage" style="@($"width:{CapacityOveragePercent(person)}%")"></i>}</span><span class="capacity-state @person.Status.ToLowerInvariant().Replace(" ","-")"><strong>@person.Status</strong><small>@CapacityLoadText(person)</small></span>@if(person.MissingEstimates>0){<small class="missing-estimate">@person.MissingEstimates not estimated</small>}<small class="capacity-baseline">@CapacityBaselineText(person.Id,NextSprint)</small>@if(person.NextLeave is not null){<small class="capacity-leave">Next off · @RangeText(person.NextLeave)</small>}</button>}</div>}</section></div>
<section class="home-card time-off-card"><header><div><span class="eyebrow">Upcoming</span><h2>Days off &amp; public holidays</h2></div><button class="text-button" @onclick="OpenDaysOffManager">✎ Manage</button></header><div class="holiday-filters"><button class="@(holidayCountryFilter=="ALL"?"active":"")" @onclick='()=>SetHolidayCountry("ALL")'>All</button>@foreach(var country in HolidayCountries){<button class="@(holidayCountryFilter==country.Code?"active":"")" @onclick="()=>SetHolidayCountry(country.Code)">@country.Name</button>}</div>@if(HomeTimeOffDays().Count==0){<div class="home-empty">No upcoming time off found.</div>}else{<div class="time-off-list">@foreach(var day in HomeTimeOffDays()){<div class="time-off-day"><span><strong>@day.Title</strong><span class="time-off-source-pills">@foreach(var source in day.Sources){<i class="time-off-source-pill">@source</i>}</span></span><time>@TimeOffDateText(day.Date)</time></div>}</div>}</section>
<section class="home-card work-summary-card"><header><div><span class="eyebrow">Remaining work</span><h2>Applications</h2></div></header>@if(Remaining(TagDimension.Application).Count==0){<div class="home-empty">Classify application tags in Settings.</div>}else{<div class="work-group-list">@foreach(var group in Remaining(TagDimension.Application)){<button @onclick="()=>OpenGroup(group.Name)"><strong>@group.Name</strong><span>@group.Count items</span><small>@group.Effort.ToString("0.#") effort</small></button>}</div>}</section>
<section class="home-card work-summary-card"><header><div><span class="eyebrow">Remaining work</span><h2>Initiatives</h2></div></header>@if(InitiativeRows().Count==0){<div class="home-empty">Classify initiative tags in Settings.</div>}else{<div class="initiative-list">@foreach(var row in InitiativeRows()){<button class="@(row.NeedsAttention?"needs-attention":"")" @onclick="()=>OpenGroup(row.Tag)"><span><strong>@row.Tag</strong><small>@row.Count items · @row.Effort.ToString("0.#") effort</small></span><span class="initiative-meta"><em>@row.Meta.Status</em><em>@row.Meta.Confidence confidence</em>@if(row.Meta.DueDate is not null){<em>Due @row.Meta.DueDate.Value.ToString("MMM d")</em>}</span></button>}</div>}</section>
</div>
</section>
}
else if(screen=="meeting"){
<section class="meeting-page">
<div class="page-heading meeting-heading"><div><div class="heading-context">Capture → structure → create</div><h1>Meeting workspace</h1><p>Take rough notes during the meeting, let Copilot structure them, then review and create the useful actions in Azure DevOps.</p></div><button @onclick="ResetMeeting">New meeting</button></div>
<div class="meeting-grid">
<section class="meeting-card meeting-notes"><header><div><span class="eyebrow">1 · Capture</span><h2>Meeting notes</h2></div></header><label>Meeting title<input @bind="meetingTitle"/></label><label>Rough notes<textarea rows="16" @bind="meetingNotes" placeholder="Write freely during the meeting. Decisions, requests, constraints, actions…"></textarea></label><div class="meeting-actions"><button class="primary" @onclick="CopyMeetingPrompt">Copy prompt for Copilot</button><small>Paste the prompt into Copilot. SprintPilot does not send your notes to an AI service.</small></div></section>
<section class="meeting-card meeting-import"><header><div><span class="eyebrow">2 · Structure</span><h2>Copilot result</h2></div></header><label>Paste Copilot JSON<textarea rows="16" @bind="meetingCopilotText" placeholder="Paste Copilot's raw JSON response here…"></textarea></label><button class="primary" @onclick="ParseMeetingCopilot">Import &amp; review</button>@if(meetingError!=""){<p class="error-text">@meetingError</p>}</section>
</div>
@if(meetingImport.Summary.Length>0||meetingImport.Decisions.Length>0){
<section class="meeting-card meeting-summary"><header><div><span class="eyebrow">Review</span><h2>Meeting summary</h2></div><button @onclick="CopyMeetingSummary">Copy summary</button></header><div class="meeting-summary-grid">@if(meetingImport.Summary.Length>0){<div><h3>Summary</h3><ul>@foreach(var line in meetingImport.Summary){<li>@line</li>}</ul></div>}@if(meetingImport.Decisions.Length>0){<div><h3>Decisions</h3><ul>@foreach(var line in meetingImport.Decisions){<li>@line</li>}</ul></div>}</div></section>}
@if(meetingActions.Count>0){
<section class="meeting-card meeting-backlog"><header><div><span class="eyebrow">3 · Act</span><h2>Backlog candidates</h2><p>Nothing is written to Azure DevOps until you press Create selected.</p></div><label class="meeting-type">Work-item type<select @bind="meetingWorkType">@foreach(var type in meta.Types.Where(t=>t.Name!="Task")){<option value="@type.Name">@type.Name</option>}</select></label></header><div class="meeting-batch-actions"><span>Selected actions</span><button @onclick="AssignSelectedMeetingActionsToMe">Assign to me</button><button @onclick='()=>SetSelectedMeetingSprint("current")'>Current sprint</button><button disabled="@(NextSprint is null)" @onclick='()=>SetSelectedMeetingSprint("next")'>Next sprint</button></div>
<div class="meeting-action-list">@foreach(var action in meetingActions){<article class="meeting-action-item @(action.CreatedId is not null?"created":"")"><div class="meeting-action-select"><input type="checkbox" @bind="action.Selected" disabled="@(action.CreatedId is not null)"/></div><div class="meeting-action-body"><label>Title<input @bind="action.Title" disabled="@(action.CreatedId is not null)"/></label><div class="meeting-action-fields"><label>Owner<select @bind="action.Owner" disabled="@(action.CreatedId is not null)"><option value="">Unassigned</option><option value="@meta.Me.UniqueName">Me · @meta.Me.Name</option>@foreach(var person in meta.People.Where(p=>p.Id!=meta.Me.Id)){<option value="@person.UniqueName">@person.Name</option>}</select></label><label>Sprint<select @bind="action.Sprint" disabled="@(action.CreatedId is not null)"><option value="current">Current · @CurrentSprint?.Name</option><option value="next" disabled="@(NextSprint is null)">Next · @(NextSprint?.Name??"not configured")</option></select></label><label>Estimate<input type="number" min="0" step="0.5" @bind="action.SuggestedEstimate" disabled="@(action.CreatedId is not null)"/></label><label>Tags<input @bind="action.TagsText" disabled="@(action.CreatedId is not null)"/></label></div><details><summary>Description &amp; acceptance criteria</summary><label>Description<textarea rows="4" @bind="action.Description" disabled="@(action.CreatedId is not null)"></textarea></label><label>Acceptance criteria<textarea rows="3" @bind="action.AcceptanceCriteria" disabled="@(action.CreatedId is not null)"></textarea></label></details>@if(action.CreatedId is not null){<div class="meeting-created">✓ Created #@action.CreatedId @if(SafeLink(action.CreatedUrl)){<a href="@action.CreatedUrl" target="_blank" rel="noopener noreferrer">Open in Azure DevOps ↗</a>}</div>}</div></article>}</div>
<div class="meeting-create-bar"><span>@meetingActions.Count(a=>a.Selected&&a.CreatedId is null) selected</span><button class="primary" disabled="@meetingCreating" @onclick="CreateMeetingActions">@(meetingCreating?"Creating…":"Create selected backlog items")</button></div>
</section>}
</section>
}
else if(screen=="branches"){
<section class="branch-cleanup-page">
<div class="page-heading branch-cleanup-heading"><div><div class="heading-context">@(Tracker.Demo?"Demo organization":connection?.Organization)</div><h1>Branch cleanup</h1><p>Find stale Azure DevOps branches across projects, understand why they look safe to remove, then delete them in a reviewed batch.</p></div><div class="toolbar"><button disabled="@branchCleanupLoading" @onclick="Refresh">↻ Refresh</button></div></div>
<div class="branch-cleanup-selectors">
<section class="branch-picker"><span class="eyebrow">1 · Project</span><input aria-label="Search projects" placeholder="Search projects…" @bind="branchProjectSearch" @bind:event="oninput"/><select aria-label="Azure DevOps project" value="@branchProject" disabled="@branchCleanupLoading" @onchange="ChangeBranchProject">@foreach(var p in FilteredBranchProjects){<option value="@p.Name">@p.Name</option>}</select><small>@branchProjects.Count accessible project@(branchProjects.Count==1?"":"s")</small></section>
<section class="branch-picker"><span class="eyebrow">2 · Repository</span><input aria-label="Search repositories" placeholder="Search repositories…" @bind="branchRepositorySearch" @bind:event="oninput"/><select aria-label="Repository" value="@branchRepositoryId" disabled="@(branchCleanupLoading||branchRepositories.Count==0)" @onchange="ChangeBranchRepository">@foreach(var r in FilteredBranchRepositories){<option value="@r.Id">@r.Name</option>}</select><small>@branchRepositories.Count repositor@(branchRepositories.Count==1?"y":"ies") in @branchProject</small></section>
</div>
@if(branchCleanupLoading){<div class="branch-cleanup-loading"><strong>Reviewing branches…</strong><span>Loading refs, pull requests and latest commit information.</span></div>}
else if(branchProjects.Count==0){<div class="empty"><h2>No projects available</h2><p>Check your Azure DevOps token permissions.</p></div>}
else if(branchRepositories.Count==0){<div class="empty"><h2>No repositories found</h2><p>Choose another project or check Code permissions.</p></div>}
else {
<div class="branch-cleanup-summary">
<article><span>Total branches</span><strong>@branches.Count</strong></article>
<article class="recommended"><span>Recommended</span><strong>@RecommendedBranches.Count()</strong></article>
<article><span>Active PR</span><strong>@branches.Count(b=>b.HasActivePullRequest)</strong></article>
<article><span>Protected / long-lived</span><strong>@branches.Count(b=>b.IsDefault||b.IsLocked||ProtectedBranchConvention(b))</strong></article>
<label>Stale threshold<select value="@prefs.BranchCleanupStaleDays" @onchange="SetBranchStaleDays"><option value="30">30 days</option><option value="60">60 days</option><option value="90">90 days</option><option value="120">120 days</option><option value="180">180 days</option><option value="365">365 days</option></select><small>Default recommendation threshold</small></label>
</div>
<section class="branch-recommendations">
<header><div><span class="eyebrow">Suggested cleanup</span><h2>Recommended to delete</h2><p>SprintPilot excludes the default branch, locked branches, active pull requests and long-lived branch names. A recommendation then needs inactivity plus either a merged PR tip or a much longer period with no active PR.</p></div><div class="toolbar"><button disabled="@(RecommendedBranches.Count()==0)" @onclick="SelectRecommendedBranches">Select recommended</button><button class="primary danger-action" disabled="@(RecommendedBranches.Count()==0)" @onclick="ReviewRecommendedBranches">Review &amp; delete @RecommendedBranches.Count()</button></div></header>
@if(RecommendedBranches.Count()==0){<div class="home-empty">No branches currently meet the conservative cleanup rules.</div>}else{<div class="branch-recommendation-list">@foreach(var b in RecommendedBranches.Take(8)){<article><div><strong>@b.Name</strong><small>@BranchReason(b)</small></div><span>@BranchAgeText(b)</span><button @onclick="()=>PrepareBranchDelete(new[]{b})">Review delete</button></article>}</div>@if(RecommendedBranches.Count()>8){<small class="muted">+ @(RecommendedBranches.Count()-8) more recommended branch(es) in the table below.</small>}}
</section>
<div class="branch-toolbar">
<input class="search" aria-label="Search branches" placeholder="Search branch, author, commit…" @bind="branchSearch" @bind:event="oninput"/>
<div class="branch-filter-pills"><button class="@(branchStatusFilter=="all"?"active":"")" @onclick='()=>branchStatusFilter="all"'>All</button><button class="@(branchStatusFilter=="recommended"?"active":"")" @onclick='()=>branchStatusFilter="recommended"'>Recommended</button><button class="@(branchStatusFilter=="active"?"active":"")" @onclick='()=>branchStatusFilter="active"'>Active PR</button><button class="@(branchStatusFilter=="protected"?"active":"")" @onclick='()=>branchStatusFilter="protected"'>Protected</button><button class="@(branchStatusFilter=="review"?"active":"")" @onclick='()=>branchStatusFilter="review"'>Needs review</button></div>
<div class="toolbar branch-selection-actions"><button @onclick="ToggleVisibleBranches">Select visible</button><span>@selectedBranches.Count selected</span><button class="primary danger-action" disabled="@(SelectedBranchRows.Count==0)" @onclick="ReviewSelectedBranches">Review selected deletion</button></div>
</div>
<div class="branch-table-wrap"><table class="branch-table"><thead><tr><th class="branch-check">Select</th><th>Branch</th><th>Assessment</th><th>Last activity</th><th>People</th><th>Pull request</th><th></th></tr></thead><tbody>
@foreach(var b in VisibleBranches){var canDelete=!b.IsDefault&&!b.IsLocked&&!b.HasActivePullRequest;<tr class="@(BranchRecommended(b)?"recommended-row":"")"><td class="branch-check"><input type="checkbox" checked="@selectedBranches.Contains(b.Name)" disabled="@(!canDelete)" @onchange="()=>ToggleBranch(b.Name)"/></td><td><strong>@b.Name</strong><small title="@b.LastCommitMessage">@if(b.LastCommitMessage==""){<text>No commit message available</text>}else{@b.LastCommitMessage}</small></td><td><span class="branch-badge @(BranchRecommended(b)?"recommended":"review")">@(BranchRecommended(b)?"Recommended":"Review")</span><small class="branch-reason">@BranchReason(b)</small></td><td><strong>@BranchAgeText(b)</strong><small>@(b.LastCommitDate?.ToLocalTime().ToString("MMM d, yyyy")??"Date unavailable")</small></td><td><span>Commit · @(b.LastCommitAuthor==""?"Unknown":b.LastCommitAuthor)</span><small>Created · @(b.Creator==""?"Unknown":b.Creator)</small></td><td>@if(b.HasActivePullRequest){<span class="branch-badge active-pr">Active PR</span>}else if(b.HasCompletedPullRequest){<span class="branch-badge merged">Merged tip</span>}else{<span class="muted">No active PR</span>}</td><td><button disabled="@(!canDelete)" @onclick="()=>PrepareBranchDelete(new[]{b})">Delete…</button></td></tr>}
</tbody></table>@if(!VisibleBranches.Any()){<div class="home-empty">No branches match the current search and filter.</div>}</div>
}
</section>
}
else if(screen=="pullrequests"){
<section class="branch-cleanup-page pr-cleanup-page">
<div class="page-heading branch-cleanup-heading"><div><div class="heading-context">@(Tracker.Demo?"Demo organization":connection?.Organization)</div><h1>Pull request cleanup</h1><p>Find stale active Azure DevOps pull requests across projects, review their source activity and reviewer signals, then abandon obsolete PRs in a controlled batch.</p></div><div class="toolbar"><button disabled="@pullRequestCleanupLoading" @onclick="Refresh">↻ Refresh</button></div></div>
<div class="branch-cleanup-selectors">
<section class="branch-picker"><span class="eyebrow">1 · Project</span><input aria-label="Search projects for pull requests" placeholder="Search projects…" @bind="pullRequestProjectSearch" @bind:event="oninput"/><select aria-label="Azure DevOps project for pull requests" value="@pullRequestProject" disabled="@pullRequestCleanupLoading" @onchange="ChangePullRequestProject">@foreach(var p in FilteredPullRequestProjects){<option value="@p.Name">@p.Name</option>}</select><small>@pullRequestProjects.Count accessible project@(pullRequestProjects.Count==1?"":"s")</small></section>
<section class="branch-picker"><span class="eyebrow">2 · Repository</span><input aria-label="Search repositories for pull requests" placeholder="Search repositories…" @bind="pullRequestRepositorySearch" @bind:event="oninput"/><select aria-label="Repository for pull requests" value="@pullRequestRepositoryId" disabled="@(pullRequestCleanupLoading||pullRequestRepositories.Count==0)" @onchange="ChangePullRequestRepository">@foreach(var r in FilteredPullRequestRepositories){<option value="@r.Id">@r.Name</option>}</select><small>@pullRequestRepositories.Count repositor@(pullRequestRepositories.Count==1?"y":"ies") in @pullRequestProject</small></section>
</div>
@if(pullRequestCleanupLoading){<div class="branch-cleanup-loading"><strong>Reviewing active pull requests…</strong><span>Loading PR metadata, reviewers and latest source commits.</span></div>}
else if(pullRequestProjects.Count==0){<div class="empty"><h2>No projects available</h2><p>Check your Azure DevOps token permissions.</p></div>}
else if(pullRequestRepositories.Count==0){<div class="empty"><h2>No repositories found</h2><p>Choose another project or check Code permissions.</p></div>}
else {
<div class="branch-cleanup-summary pr-cleanup-summary">
<article><span>Active PRs</span><strong>@pullRequests.Count</strong></article>
<article class="recommended"><span>Recommended</span><strong>@RecommendedPullRequests.Count()</strong></article>
<article><span>Drafts</span><strong>@pullRequests.Count(p=>p.IsDraft)</strong></article>
<article><span>With approvals</span><strong>@pullRequests.Count(p=>p.ApprovalCount>0)</strong></article>
<label>Stale threshold<select value="@prefs.PullRequestCleanupStaleDays" @onchange="SetPullRequestStaleDays"><option value="30">30 days</option><option value="60">60 days</option><option value="90">90 days</option><option value="120">120 days</option><option value="180">180 days</option><option value="365">365 days</option></select><small>Used for stale-draft recommendations</small></label>
</div>
<section class="branch-recommendations pr-recommendations">
<header><div><span class="eyebrow">Suggested cleanup</span><h2>Recommended to abandon</h2><p>SprintPilot is conservative: PRs with approvals, blocking reviewer votes, unavailable activity data or long-lived source branches are never recommended automatically. Drafts must be stale for the configured threshold; non-drafts must be stale for at least 180 days or twice the threshold.</p></div><div class="toolbar"><button disabled="@(RecommendedPullRequests.Count()==0)" @onclick="SelectRecommendedPullRequests">Select recommended</button><button class="primary danger-action" disabled="@(RecommendedPullRequests.Count()==0)" @onclick="ReviewRecommendedPullRequests">Review &amp; abandon @RecommendedPullRequests.Count()</button></div></header>
@if(RecommendedPullRequests.Count()==0){<div class="home-empty">No active pull requests currently meet the conservative cleanup rules.</div>}else{<div class="branch-recommendation-list">@foreach(var p in RecommendedPullRequests.Take(8)){<article><div><strong>#@p.Id · @p.Title</strong><small>@PullRequestReason(p)</small></div><span>@PullRequestAgeText(p)</span><button @onclick="()=>PreparePullRequestAbandon(new[]{p})">Review abandon</button></article>}</div>@if(RecommendedPullRequests.Count()>8){<small class="muted">+ @(RecommendedPullRequests.Count()-8) more recommended PR(s) in the table below.</small>}}
</section>
<div class="branch-toolbar pr-toolbar">
<input class="search" aria-label="Search pull requests" placeholder="Search PR, branch, creator…" @bind="pullRequestSearch" @bind:event="oninput"/>
<div class="branch-filter-pills"><button class="@(pullRequestStatusFilter=="all"?"active":"")" @onclick='()=>pullRequestStatusFilter="all"'>All active</button><button class="@(pullRequestStatusFilter=="recommended"?"active":"")" @onclick='()=>pullRequestStatusFilter="recommended"'>Recommended</button><button class="@(pullRequestStatusFilter=="draft"?"active":"")" @onclick='()=>pullRequestStatusFilter="draft"'>Drafts</button><button class="@(pullRequestStatusFilter=="approved"?"active":"")" @onclick='()=>pullRequestStatusFilter="approved"'>Approved</button><button class="@(pullRequestStatusFilter=="conflicts"?"active":"")" @onclick='()=>pullRequestStatusFilter="conflicts"'>Conflicts</button><button class="@(pullRequestStatusFilter=="review"?"active":"")" @onclick='()=>pullRequestStatusFilter="review"'>Needs review</button></div>
<div class="toolbar branch-selection-actions"><button @onclick="ToggleVisiblePullRequests">Select visible</button><span>@selectedPullRequests.Count selected</span><button class="primary danger-action" disabled="@(SelectedPullRequestRows.Count==0)" @onclick="ReviewSelectedPullRequests">Review selected cleanup</button></div>
</div>
<div class="branch-table-wrap"><table class="branch-table pr-table"><thead><tr><th class="branch-check">Select</th><th>Pull request</th><th>Branches</th><th>Assessment</th><th>Activity</th><th>Review</th><th>Merge</th><th></th></tr></thead><tbody>
@foreach(var p in VisiblePullRequests){<tr class="@(PullRequestRecommended(p)?"recommended-row":"")"><td class="branch-check"><input type="checkbox" checked="@selectedPullRequests.Contains(p.Id)" @onchange="()=>TogglePullRequest(p.Id)"/></td><td><strong>#@p.Id · @p.Title</strong><small>Created by @(p.Creator==""?"Unknown":p.Creator) · @p.CreatedDate.ToLocalTime().ToString("MMM d, yyyy") @if(p.IsDraft){<text> · Draft</text>}</small></td><td><strong>@p.SourceBranch → @p.TargetBranch</strong><small title="@p.LastCommitMessage">@if(p.LastCommitMessage==""){<text>No commit message available</text>}else{@p.LastCommitMessage}</small></td><td><span class="branch-badge @(PullRequestRecommended(p)?"recommended":"review")">@(PullRequestRecommended(p)?"Recommended":"Review")</span><small class="branch-reason">@PullRequestReason(p)</small></td><td><strong>@PullRequestAgeText(p)</strong><small>@PullRequestStaleText(p)</small></td><td><span>@p.ReviewerCount reviewer@(p.ReviewerCount==1?"":"s")</span><small>@p.ApprovalCount approval@(p.ApprovalCount==1?"":"s") · @p.BlockingVoteCount blocking</small></td><td>@if(p.MergeStatus.Equals("conflicts",StringComparison.OrdinalIgnoreCase)){<span class="branch-badge active-pr">Conflicts</span>}else{<span class="branch-badge merged">@(p.MergeStatus==""?"Unknown":p.MergeStatus)</span>}</td><td><div class="pr-row-actions">@if(SafeLink(p.Url)){<a target="_blank" rel="noopener noreferrer" href="@p.Url">Open ↗</a>}<button @onclick="()=>PreparePullRequestAbandon(new[]{p})">Abandon…</button></div></td></tr>}
</tbody></table>@if(!VisiblePullRequests.Any()){<div class="home-empty">No active pull requests match the current search and filter.</div>}</div>
}
</section>
}
else {
<section class="workspace sprint-workspace @(DailyMode?"daily-workspace":"list-workspace") @(screen=="workspace"&&workspaceOwnerMode?"owner-priority-mode":"")">
@if(screen=="cleanup"){<h1>Sprint cleanup</h1>}
<div class="workspace-top-controls"><div class="workspace-context-row"><div class="sprint-bar"><button title="Previous sprint (Alt+Left)" disabled="@(sprintIndex<=0||busy.Count>0)" @onclick="()=>Navigate(-1)">← @Adjacent(-1)</button><button class="current-sprint" @onclick='()=>Show("iterations")'>@CurrentSprint?.Name <span>⌄</span><strong>@items.Count @(items.Count==1?"item":"items")</strong><small>@DateRange</small></button><button title="Next sprint (Alt+Right)" disabled="@(sprintIndex>=meta.Iterations.Length-1||busy.Count>0)" @onclick="()=>Navigate(1)">@Adjacent(1) →</button></div>
</div>
@if(screen=="workspace"){
<form class="workspace-quick-add" @onsubmit="CreateWorkspacePbi" @onsubmit:preventDefault>
<input aria-label="New PBI title" maxlength="255" placeholder="Add a PBI to this sprint…" @bind="quickPbiTitle" @bind:event="oninput" disabled="@quickPbiCreating"/>
<button class="primary" type="submit" disabled="@(quickPbiCreating||string.IsNullOrWhiteSpace(quickPbiTitle)||CurrentSprint is null)">@(quickPbiCreating?"Adding…":"+ Add PBI")</button>
</form>
}
<div class="toolbar"><button disabled="@loading" title="Refresh (R)" aria-label="Refresh sprint" @onclick="Refresh">↻</button><button @onclick="NewItem">Full work item form</button></div></div>
@if(screen=="workspace"&&quickPbiError!=""){<p class="quick-add-error" role="alert">@quickPbiError</p>}

@if(!DailyMode){<div class="view-tabs workspace-secondary-actions" hidden="@(!moreFilters)">@foreach(var v in QuickViews){<button class="@(quickView==v?"active":"")" @onclick="()=>SetQuickView(v)">@v</button>}@if(screen=="workspace"){<button class="workspace-owner-mode @(workspaceOwnerMode?"active":"")" @onclick="ToggleWorkspaceOwnerMode">👤 Prioritize by person</button><button @onclick="PrepareSmartOrder">⚡ Smart order</button>}<button class="prepare" @onclick="PrepareNext">Prepare next sprint →</button></div>@if(screen=="workspace"&&workspaceOwnerMode){<div class="workspace-owner-strip"><span>Priority owner</span>@foreach(var person in WorkspacePriorityPeople){<button class="@(workspacePriorityOwner==person.Id?"active":"")" @onclick="()=>SetWorkspacePriorityOwner(person.Id)">@person.Name <strong>@person.Count</strong></button>}<button class="text-button workspace-owner-exit" @onclick="ToggleWorkspaceOwnerMode">All work ×</button></div>}}
else{<div class="daily-toolbar"><div class="daily-add"><input aria-label="Find work item to add to daily" placeholder="Add item by ID or title…" @bind="dailyLookupText" @bind:event="oninput"/><button disabled="@dailyLookupBusy" @onclick="SearchDailyWork">@(dailyLookupBusy?"Searching…":"Find")</button></div><div class="daily-toolbar-actions"><span class="daily-preset">Active work</span><button class="@(!dailyActiveOnly?"active":"")" @onclick="ToggleDailyActiveOnly">@(!dailyActiveOnly?"✓ Recently closed":"Show recently closed")</button></div></div>@if(dailyLookupResults.Count>0){<div class="daily-search-results">@foreach(var result in dailyLookupResults){<button disabled="@busy.Contains(result.Id)" @onclick="()=>AddDailyItem(result)"><span>#@result.Id · @DisplayTitle(result)</span><small>@(result.Owner==""?"Unassigned":result.Owner) · @result.Iteration</small><strong>+ Add</strong></button>}</div>}}
@if(screen=="cleanup"){
<div class="health"><h2>Where this sprint needs attention</h2><p>Use the groups below to narrow the list without hunting through Azure DevOps filters.</p><div class="health-counts">@foreach(var group in CleanupCounts){<button class="@(cleanupFilter==group.Key?"active":"")" @onclick="()=>cleanupFilter=cleanupFilter==group.Key?string.Empty:group.Key"><strong>@group.Value</strong>@group.Key</button>}</div></div>}
<div class="filter-shell"><div class="filter-primary">@if(screen=="workspace"){<div class="workspace-mode-tabs" aria-label="Sprint workspace mode"><button class="@(workspaceMode=="Overview"?"active":"")" @onclick='()=>SetWorkspaceMode("Overview")'>Overview</button><button class="@(workspaceMode=="Daily"?"active":"")" @onclick='()=>SetWorkspaceMode("Daily")'>Daily</button></div>}<input id="search" class="search" aria-label="Search work items" placeholder="Search ID, title, tags…  /" @bind="search" @bind:event="oninput"/>@if(screen=="workspace"){<button class="filter-pill @(workspaceActiveOnly?"active":"")" @onclick="ToggleWorkspaceActiveOnly">Active only</button>}<button aria-expanded="@(moreFilters ? "true" : "false")" @onclick="()=>moreFilters=!moreFilters">More filters @(moreFilters?"−":"+")</button>@if(moreFilters&&!DailyMode){<button @onclick='()=>Show("columns")'>Columns</button>}<button class="text-button" @onclick="ClearFilters">Clear</button></div>
<div class="active-filter-summary" aria-label="Active filters">
@if(quickView!="Team"){<button class="filter-pill active" @onclick='()=>SetQuickView("Team")'>View: @quickView ×</button>}
@if(workspaceBlockedOnly){<button class="filter-pill active" @onclick="ToggleWorkspaceBlockedOnly">Blocked ×</button>}
@if(applicationFilter!=""){<button class="filter-pill active" @onclick='()=>applicationFilter=""'>App: @applicationFilter ×</button>}
@if(tagFilter!=""){<button class="filter-pill active" @onclick='()=>tagFilter=""'>Tag: @tagFilter ×</button>}
@if(typeFilter!=""){<button class="filter-pill active" @onclick='()=>typeFilter=""'>Type: @typeFilter ×</button>}
@if(areaFilter!=""){<button class="filter-pill active" @onclick='()=>areaFilter=""'>Area: @areaFilter ×</button>}
@if(priorityFilter!=""){<button class="filter-pill active" @onclick='()=>priorityFilter=""'>Priority: @priorityFilter ×</button>}
@if(attentionFilter!=""){<button class="filter-pill active" @onclick='()=>attentionFilter=""'>Attention: @attentionFilter ×</button>}
</div>
<div class="filter-groups">
<div class="filter-group"><span class="filter-group-label">Person</span><div class="filter-pills">@foreach(var person in FilterPeople){<button class="filter-pill @(ownerFilters.Contains(person.Id)?"active":"")" @onclick="()=>ToggleOwner(person.Id)">@person.Name <strong>@person.Count</strong></button>}</div></div>
@if(moreFilters&&screen=="workspace"){<div class="filter-group compact-filter-group"><span class="filter-group-label">Work</span><div class="filter-pills"><button class="filter-pill blocked-filter @(workspaceBlockedOnly?"active":"")" @onclick="ToggleWorkspaceBlockedOnly">Blocked only</button></div></div>}
@if(moreFilters&&FilterApplications.Any()){<div class="filter-group"><span class="filter-group-label">Applications</span><div class="filter-pills horizontal">@foreach(var app in FilterApplications){<button class="filter-pill @(applicationFilter.Equals(app.Tag,StringComparison.OrdinalIgnoreCase)?"active":"")" @onclick="()=>ToggleApplicationPill(app.Tag)">@app.Tag <strong>@app.Count</strong></button>}</div></div>}
@if(moreFilters&&FilterTags.Any()){<div class="filter-group"><span class="filter-group-label">Tags</span><div class="filter-pills horizontal">@foreach(var tag in FilterTags){<button class="filter-pill @(tagFilter.Equals(tag.Tag,StringComparison.OrdinalIgnoreCase)?"active":"")" @onclick="()=>ToggleTagPill(tag.Tag)">@tag.Tag <strong>@tag.Count</strong></button>}</div></div>}
</div>
@if(moreFilters){<div class="filter-more"><input class="filter-value-search" aria-label="Search filter values" placeholder="Find owner, application or tag…" @bind="filterOptionSearch" @bind:event="oninput"/><input aria-label="Filter type" list="filter-types" placeholder="All types" @bind="typeFilter" @bind:event="oninput"/><datalist id="filter-types">@foreach(var t in CurrentOpenItems.Select(w=>w.Type).Distinct(StringComparer.OrdinalIgnoreCase).Order()){<option value="@t"></option>}</datalist><input aria-label="Filter area" list="filter-areas" placeholder="All areas" @bind="areaFilter" @bind:event="oninput"/><datalist id="filter-areas">@foreach(var a in CurrentOpenItems.Select(w=>w.Area).Distinct(StringComparer.OrdinalIgnoreCase).Order()){<option value="@a"></option>}</datalist><input aria-label="Filter priority" list="filter-priorities" placeholder="All priorities" @bind="priorityFilter" @bind:event="oninput"/><datalist id="filter-priorities">@foreach(var p in CurrentOpenItems.Select(w=>w.Priority).OfType<int>().Distinct().Order()){<option value="@p"></option>}</datalist><button @onclick='()=>Show("saveview")'>Save view</button></div>}</div>
@if(!DailyMode){<div class="grid-status" aria-live="polite"><span>@Visible.Count work items @(loading?"· Refreshing…":"")</span><span>@(SelectedItems.Count>0?$"{SelectedItems.Count} selected":"Select visible items to edit in bulk")</span><button disabled="@(Visible.Count==0||sprintIndex>=meta.Iterations.Length-1)" @onclick="SelectVisibleAndMoveNext">Move filtered result to next sprint →</button></div>}
@if(DailyMode){
@if(UpcomingDaysOff().Count>0||UpcomingHolidays().Count>0){<div class="days-off-summary"><div class="days-off-summary-title"><strong>Days off &amp; holidays</strong><span>Azure DevOps + public holidays</span></div><div class="holiday-filters compact"><button class="@(holidayCountryFilter=="ALL"?"active":"")" @onclick='()=>SetHolidayCountry("ALL")'>All</button>@foreach(var country in HolidayCountries){<button class="@(holidayCountryFilter==country.Code?"active":"")" @onclick="()=>SetHolidayCountry(country.Code)">@country.Name</button>}</div><div class="days-off-periods">@foreach(var leave in VisibleDaysOff()){<span class="leave-period"><strong>@leave.Name</strong> @RangeText(leave.Range) <em class="@(InSelectedSprint(leave.Range)?"current-sprint-leave":"other-sprint-leave")">@(InSelectedSprint(leave.Range)?"Current sprint":"Other sprint")</em></span>}@foreach(var holiday in VisibleHolidays()){<span class="leave-period holiday-period"><strong>@holiday.Name</strong> <small>@holiday.Country</small> @holiday.Start.ToString("MMM d") <em class="@(InSelectedSprint(holiday)?"current-sprint-leave":"other-sprint-leave")">@(InSelectedSprint(holiday)?"Current sprint":"Other sprint")</em></span>}</div>@if(HiddenDaysOffCount()>0||showAllDaysOff){<button class="text-button days-off-more" @onclick="()=>showAllDaysOff=!showAllDaysOff">@(showAllDaysOff?"Show less":$"Show {HiddenDaysOffCount()} more")</button>}</div>}
<div class="daily-person-strip" aria-label="Choose a person for Daily"><button class="@(dailyFocusOwner==""?"active":"")" @onclick="ClearDailyFocus">Team overview</button>@foreach(var person in DailyPeople()){<button class="@(dailyFocusOwner==person.Id?"active":"")" @onclick="()=>FocusDaily(person.Id)"><span>@person.Name</span><small>@person.Open open@if(!dailyActiveOnly&&person.RecentlyClosed>0){<text> · @person.RecentlyClosed closed</text>}</small></button>}</div>
@if(dailyFocusOwner==""){
<div class="people-board-heading compact-daily-heading"><div><h2>Team overview</h2><p>Choose a person to review and reprioritize their work.</p></div><strong>@DailyPeople().Sum(x=>x.Open) open</strong></div>
<div class="daily-team-overview">@foreach(var person in DailyPeople()){var top=DailyOpenFor(person.Id).Take(2).ToArray();<button class="daily-person-summary @(OffToday(person.Id)?"person-off":"")" @onclick="()=>FocusDaily(person.Id)"><header><span><strong>@person.Name</strong>@if(OffToday(person.Id)){<em>Off today</em>}</span><span class="daily-summary-count">@person.Open</span></header><div class="daily-summary-metrics"><span>@person.Open open</span>@if(!dailyActiveOnly){<span>@person.RecentlyClosed recently closed</span>}</div>@if(top.Length==0){<small>No open work in the current filters.</small>}else{<div class="daily-summary-priorities">@foreach(var item in top){<span><b>#@item.Id</b> @DisplayTitle(item)</span>}</div>}<footer>Open person →</footer></button>}</div>
}else{
var focusPerson=meta.People.FirstOrDefault(p=>p.Id==dailyFocusOwner);var openWork=DailyOpenFor(dailyFocusOwner);var recentlyClosed=RecentlyClosedFor(dailyFocusOwner);
<div class="daily-focus-heading"><div><span class="eyebrow">Person focus</span><h2>@(focusPerson?.Name??"Person")</h2><p>@openWork.Count open item@(openWork.Count==1?"":"s")@if(OffToday(dailyFocusOwner)){<text> · Off today</text>}</p></div><div class="daily-focus-nav"><button @onclick="()=>MoveDailyFocus(-1)">←</button><button @onclick="ClearDailyFocus">Team overview</button><button @onclick="()=>MoveDailyFocus(1)">→</button></div></div>
@if(!dailyActiveOnly){<section class="recently-closed-section"><header><div><span class="eyebrow">Recently closed</span><h3>Completed since the last working day</h3></div><small>@RecentClosedSinceLabel</small></header>@if(recentlyClosed.Count==0){<div class="daily-empty-line">Nothing closed in this window.</div>}else{<div class="recently-closed-list">@foreach(var w in recentlyClosed){<button @onclick="()=>OpenDetail(w)"><span class="recently-closed-check">✓</span><span><strong>#@w.Id · @DisplayTitle(w)</strong><small>@w.State · @w.Changed.ToLocalTime().ToString("MMM d, HH:mm")</small></span><span>Open →</span></button>}</div>}</section>}
<section class="daily-open-section"><header><div><span class="eyebrow">Priority order</span><h3>Open work</h3></div><span>@openWork.Count item@(openWork.Count==1?"":"s")</span></header>@if(openWork.Count==0){<div class="daily-empty-line">No open work matches the current filters.</div>}else{<div class="daily-focus-list">@foreach(var w in openWork){<article @key="w.Id" @ondragenter="()=>DailyDragOver(w)" @ondragover:preventDefault @ondrop="()=>DailyDropOn(w)" class="daily-focus-item @(busy.Contains(w.Id)?"saving":"") @(Blocked(w)?"blocked":"") @DailyDropClass(w)"><span class="card-drag-handle @(!CanOrder(w)?"disabled":"")" draggable="@(CanOrder(w) ? "true" : "false")" title="@(CanOrder(w)?"Drag to reprioritize":"This item cannot be reordered")" @onmousedown:stopPropagation="true" @onclick:stopPropagation="true" @ondragstart="()=>DailyDragStart(w)" @ondragend="DailyDragEnd" aria-hidden="true">⠿</span><button class="daily-focus-title" title="@w.Title" @onclick="()=>OpenDetail(w)"><span>#@w.Id</span><strong>@DisplayTitle(w)</strong><small>@w.State · @(w.Estimate?.ToString("0.#")??"?") effort</small></button><div class="daily-focus-tags">@foreach(var tag in w.Tags.Take(2)){<span class="tag-chip @(prefs.BlockedTags.Contains(tag,StringComparer.OrdinalIgnoreCase)?"blocked-tag":"")">@(prefs.BlockedTags.Contains(tag,StringComparer.OrdinalIgnoreCase)?"Blocked":tag)</span>}@if(w.Tags.Length>2){<span class="tag-more">+@(w.Tags.Length-2)</span>}</div><div class="daily-focus-actions">@if(DoneState(w) is not null){<button class="done-action" disabled="@busy.Contains(w.Id)" @onclick="()=>MarkDone(w)">✓ Done</button>}@if(w.CommentCount>0){<button @onclick="()=>OpenDailyPanel(w)">💬 @w.CommentCount</button>}<span class="owner-select-control"><span class="owner-avatar" aria-hidden="true">●</span><select aria-label="Assign work item @w.Id" value="@OwnerValue(w)" disabled="@(busy.Contains(w.Id)||drafts.ContainsKey(w.Id))" @onchange="e=>InlineEdit((w,ItemField.Owner,e.Value?.ToString()??string.Empty))"><option value="">Unassigned</option>@foreach(var p in meta.People){<option value="@p.UniqueName">@p.Name</option>}</select><span class="owner-chevron" aria-hidden="true">⌄</span></span></div></article>}</div>}</section>
}
}else{
<WorkGrid Items="Visible" Meta="meta" Columns="WorkspaceColumns" Selected="selected" Busy="busy" Drafts="drafts.Keys.ToHashSet()" TagSuggestions="TagSuggestions" BlockedTags="prefs.BlockedTags" SuggestedTags="SuggestedTags" AcceptTag="AddSuggestedTag" RemoveTag="RemoveTag" DragStart="DragStart" Drop="DropOn" MoveOrder="MoveOrder" CanReorder="CanOrder" SortedBy="@sort" Descending="descending" Sort="Sort" Select="Select" SelectAll="ToggleAll" Open="OpenDetail" OpenParent="OpenById" Edit="InlineEdit"/>
}
@if(SelectedItems.Count>0){<div class="bulk-bar"><strong>@SelectedItems.Count selected</strong><button @onclick='()=>StartBulk("Owner")'>Assign ⌄</button><button @onclick='()=>StartBulk("AddTag")'>+ Tag</button><button @onclick='()=>StartBulk("RemoveTag")'>Remove tag</button><button @onclick='()=>StartBulk("Previous")'>← Sprint</button><button @onclick='()=>StartBulk("Next")'>Sprint →</button><button @onclick='()=>StartBulk("Iteration")'>Choose sprint</button><button @onclick='()=>StartBulk("State")'>State ⌄</button><button @onclick='()=>StartBulk("Area")'>Area</button><button @onclick='()=>StartBulk("Priority")'>Priority</button><button class="smart-fix-trigger" @onclick="PrepareSmartFix">⚡ Smart Fix</button><button @onclick='()=>OpenPrompt(SelectedItems)'>Generate Copilot prompt</button><button @onclick="PasteSelected">Paste AI review</button><button @onclick="selected.Clear">Clear</button></div>}
</section>
}
</main></div>
@if(HomeModalOpen&&meta is not null){
<div class="scrim dashboard-modal-scrim" @onclick="CloseHomeModal"><section class="dialog dashboard-work-dialog @(homeModal=="days-off"?"days-off-dialog":"")" role="dialog" aria-modal="true" aria-label="@homeModalTitle" @onclick:stopPropagation>
<header><div><h2>@homeModalTitle</h2>@if(homeModalIterationPath!=""){<small>@meta.Iterations.FirstOrDefault(i=>i.Path==homeModalIterationPath)?.Name</small>}</div><button aria-label="Close" disabled="@(homeModalApplying||homeAddCreating||detailSaving||leaveSaving)" @onclick="CloseHomeModal">×</button></header>
@if(homeModalError!=""){<div class="dialog-error" role="alert">@homeModalError</div>}
@if(homeModal=="days-off"){
 <div class="leave-manager">
  <section class="leave-editor"><div><span class="eyebrow">@(editingDevOpsIterationId!=""?"Edit Azure DevOps day off":editingManualLeaveId!=""?"Edit manual day off":"Add day off")</span><h3>@(editingDevOpsIterationId!=""?"Azure DevOps capacity": "SprintPilot manual leave")</h3></div>
   <div class="leave-editor-fields"><label>Person<select @bind="leavePersonId" disabled="@(leaveSaving||editingDevOpsIterationId!="")">@foreach(var person in meta.People){<option value="@person.Id">@person.Name</option>}</select></label><label>Start<input type="date" @bind="leaveStart" disabled="@leaveSaving"/></label><label>End<input type="date" @bind="leaveEnd" disabled="@leaveSaving"/></label>@if(editingDevOpsIterationId==""){<label class="leave-note">Note<input placeholder="Optional note" @bind="leaveNote" disabled="@leaveSaving"/></label>}</div>
   <div class="toolbar"><button disabled="@leaveSaving" @onclick="ResetLeaveEditor">New</button><button class="primary" disabled="@leaveSaving" @onclick="SaveLeave">@(leaveSaving?"Saving…":editingDevOpsIterationId!=""?"Save to Azure DevOps":editingManualLeaveId!=""?"Save changes":"+ Add day off")</button></div>
  </section>
  <div class="leave-source-grid">
   <section><header><div><strong>Azure DevOps</strong><small>Edit capacity days off in place</small></div></header>@if(DevOpsLeaveRows().Count==0){<div class="home-empty compact">No upcoming Azure DevOps days off loaded.</div>}else{<div class="leave-list">@foreach(var leave in DevOpsLeaveRows()){<button class="leave-row" @onclick="()=>StartDevOpsLeaveEdit(leave)"><span><strong>@leave.PersonName</strong><small>@leave.IterationName · @RangeText(leave.Range)</small></span><em>DevOps · Edit</em></button>}</div>}</section>
   <section><header><div><strong>Manual</strong><small>Stored locally in SprintPilot</small></div></header>@if(prefs.ManualDaysOff.Count==0){<div class="home-empty compact">No manual days off.</div>}else{<div class="leave-list">@foreach(var leave in prefs.ManualDaysOff.OrderBy(x=>x.Start)){<div class="leave-row manual"><button @onclick="()=>StartManualLeaveEdit(leave)"><span><strong>@PersonName(leave.PersonId)</strong><small>@RangeText(new DateRange(leave.Start,leave.End))@if(leave.Note!=""){<text> · @leave.Note</text>}</small></span><em>Manual · Edit</em></button><button class="icon-button danger" title="Delete manual day off" @onclick="()=>DeleteManualLeave(leave.Id)">×</button></div>}</div>}</section>
  </div>
 </div>
}else if(HomeWorkModal){
 <div class="dashboard-modal-toolbar">
  <label>Application<select @bind="homeModalApplicationFilter"><option value="">All applications</option>@foreach(var app in ApplicationTags()){<option value="@app">@app</option>}</select></label>
  @if(homeModal!="person"){<label>Owner<select @bind="homeModalOwnerFilter"><option value="">All people</option>@foreach(var person in meta.People){<option value="@person.Id">@person.Name</option>}</select></label>}
  <span>@HomeModalVisibleItems.Count() item@(HomeModalVisibleItems.Count()==1?"":"s")</span>
 </div>
 <details class="home-add-backlog" open="@(homeModal=="person"&&homeModalItems.Count==0)">
  <summary>+ Add backlog item</summary>
  <div class="home-add-backlog-grid"><label class="wide">Title<input maxlength="255" placeholder="What needs to be done?" value="@homeAddTitle" @oninput="HomeAddTitleChanged"/></label><label>Owner<select @bind="homeAddOwner"><option value="">Unassigned</option>@foreach(var person in meta.People){<option value="@person.UniqueName">@person.Name</option>}</select></label><label>Application<select value="@homeAddApplication" @onchange="HomeAddApplicationChanged"><option value="">@(string.IsNullOrWhiteSpace(homeAddTitle)?"Choose application":"No confident suggestion")</option>@foreach(var app in ApplicationTags()){<option value="@app">@app</option>}</select></label><button class="primary" disabled="@(homeAddCreating||string.IsNullOrWhiteSpace(homeAddTitle))" @onclick="CreateHomeBacklog">@(homeAddCreating?"Creating…":"Add item")</button></div>
  @if(homeAddError!=""){<p class="quick-add-error">@homeAddError</p>}
 </details>
 @if(homeModal=="move-next"){<div class="move-next-selection-bar"><label class="checkbox"><input type="checkbox" checked="@(HomeModalVisibleItems.Any()&&HomeModalVisibleItems.All(w=>homeModalSelection.Contains(w.Id)))" @onchange="ToggleHomeModalVisible"/>Select visible</label><span>@homeModalSelection.Count selected</span><button class="primary" disabled="@(homeModalSelection.Count==0||homeModalApplying)" @onclick="MoveSelectedHomeItems">@(homeModalApplying?"Moving…":$"Move {homeModalSelection.Count} to {NextSprint?.Name}")</button></div>}
 <div class="work-master-detail">
  <div class="work-master-list">@if(!HomeModalVisibleItems.Any()){<div class="home-empty">No work items match this view.</div>}@foreach(var w in HomeModalVisibleItems){<div class="work-master-row @(detail?.Id==w.Id?"active":"")">@if(homeModal=="move-next"){<input type="checkbox" checked="@homeModalSelection.Contains(w.Id)" @onchange="()=>ToggleHomeModalItem(w.Id)"/>}<button @onclick="()=>StartDetailEdit(w)"><span><strong>#@w.Id · @DisplayTitle(w)</strong><small>@PersonName(w.OwnerId) · @w.State · @(w.Estimate?.ToString("0.#")??"?") effort</small></span><span class="tags">@foreach(var tag in w.Tags.Take(2)){<i>@tag</i>}</span></button></div>}</div>
  <div class="work-detail-pane">
   @if(detail is null){<div class="home-empty">Select a work item to see and edit its details.</div>}
   else {var definition=meta.Types.First(t=>t.Name==detail.Type);
    <div class="embedded-detail-header"><div><span class="eyebrow">#@detail.Id · @detail.Type</span><strong class="detail-save-state @(DetailDirty?"dirty":"")">@(DetailDirty?"Unsaved changes":"Up to date")</strong></div>@if(SafeLink(detail.Url)){<a target="_blank" rel="noopener noreferrer" href="@detail.Url">Azure DevOps ↗</a>}</div>
    <label class="detail-title-field">Title<input maxlength="255" @bind="detailTitle" @bind:event="oninput" disabled="@detailSaving"/></label><p class="muted">@detail.Iteration · revision @detail.Revision</p>
    <div class="detail-edit-grid"><label>Owner<select @bind="detailOwner" disabled="@detailSaving"><option value="">Unassigned</option>@foreach(var person in meta.People){<option value="@person.UniqueName">@person.Name</option>}</select></label><label>Status<select @bind="detailState" disabled="@detailSaving">@foreach(var state in definition.States){<option value="@state.Name">@state.Name</option>}</select></label><label>Estimate<input type="number" min="0" step="0.5" @bind="detailEstimate" disabled="@(detailSaving||definition.EstimateField is null)"/></label><label>Tags<input list="home-detail-known-tags" @bind="detailTags" @bind:event="oninput" disabled="@detailSaving"/><datalist id="home-detail-known-tags">@foreach(var tag in TagSuggestions){<option value="@tag"></option>}</datalist></label></div>
    <label>Description<textarea rows="10" @bind="detailDescription" @bind:event="oninput" disabled="@detailSaving"></textarea></label><label>Acceptance criteria<textarea rows="7" @bind="detailAcceptance" @bind:event="oninput" disabled="@detailSaving"></textarea></label>
    <footer class="detail-save-bar"><span></span><div class="toolbar"><button disabled="@(!DetailDirty||detailSaving)" @onclick="CancelDetailEdits">Cancel</button><button class="primary" disabled="@(!DetailDirty||detailSaving)" @onclick="SaveDetail">@(detailSaving?"Saving…":"Save to Azure DevOps")</button></div></footer>
   }
  </div>
 </div>
}
</section></div>
}
@if(detail is not null&&meta is not null&&!HomeModalOpen){var definition=meta.Types.First(t=>t.Name==detail.Type);
<aside class="detail-panel editable-detail-panel" role="dialog" aria-modal="false" aria-label="Edit work item"><header><div><span>#@detail.Id · @detail.Type</span><strong class="detail-save-state @(DetailDirty?"dirty":"")">@(DetailDirty?"Unsaved changes":"Up to date")</strong></div><button aria-label="Close details" disabled="@detailSaving" @onclick="CloseDetail">×</button></header>
<label class="detail-title-field">Title<input maxlength="255" @bind="detailTitle" @bind:event="oninput" disabled="@detailSaving"/></label><p class="muted">@detail.Iteration · revision @detail.Revision</p>
<div class="detail-edit-grid"><label>Owner<select @bind="detailOwner" disabled="@detailSaving"><option value="">Unassigned</option>@if(detail.OwnerId!=""&&!meta.People.Any(p=>p.Id==detail.OwnerId)){<option value="@OwnerValue(detail)">@detail.Owner</option>}@foreach(var p in meta.People){<option value="@p.UniqueName">@p.Name</option>}</select></label><label>Status<select @bind="detailState" disabled="@detailSaving">@foreach(var state in definition.States){<option value="@state.Name">@state.Name</option>}</select></label><label>Estimate<input type="number" min="0" step="0.5" @bind="detailEstimate" disabled="@(detailSaving||definition.EstimateField is null)"/></label><label>Tags<input list="detail-known-tags" @bind="detailTags" @bind:event="oninput" disabled="@detailSaving"/><datalist id="detail-known-tags">@foreach(var tag in TagSuggestions){<option value="@tag"></option>}</datalist></label></div>
<label>Description<textarea rows="10" @bind="detailDescription" @bind:event="oninput" disabled="@detailSaving"></textarea></label><label>Acceptance criteria<textarea rows="8" @bind="detailAcceptance" @bind:event="oninput" disabled="@detailSaving"></textarea>@if(!definition.Fields.Contains("Microsoft.VSTS.Common.AcceptanceCriteria")){<small>This work-item type has no dedicated acceptance-criteria field; SprintPilot saves it with the description.</small>}</label>
@if(detail.Parent is {} parent){<p>Parent <button disabled="@detailSaving" @onclick="()=>OpenById(parent)">#@parent</button></p>}
<footer class="detail-save-bar"><div>@if(SafeLink(detail.Url)){<a target="_blank" rel="noopener noreferrer" href="@detail.Url">Open in Azure DevOps ↗</a>}</div><div class="toolbar"><button disabled="@(!DetailDirty||detailSaving)" @onclick="CancelDetailEdits">Cancel</button><button class="primary" disabled="@(!DetailDirty||detailSaving)" @onclick="SaveDetail">@(detailSaving?"Saving…":"Save to Azure DevOps")</button></div></footer>
</aside>}
@if(dailyPanelItem is not null&&meta is not null){var panel=dailyPanelItem;
<aside class="daily-side-panel" role="dialog" aria-modal="false" aria-label="Daily work item actions"><header><div><span class="eyebrow">Daily actions</span><strong>#@panel.Id</strong></div><button aria-label="Close daily actions" @onclick="()=>dailyPanelItem=null">×</button></header><h2 title="@panel.Title">@panel.Title</h2><p class="muted">@panel.Type · sprint order @(panel.Order?.ToString("0.##")??"not available")</p>
<div class="daily-panel-fields"><label>Owner<span class="owner-select-control panel-owner-select"><span class="owner-avatar" aria-hidden="true">●</span><select value="@OwnerValue(panel)" disabled="@busy.Contains(panel.Id)" @onchange="ReassignDailyPanel"><option value="">Unassigned</option>@foreach(var p in meta.People){<option value="@p.UniqueName">@p.Name</option>}</select><span class="owner-chevron" aria-hidden="true">⌄</span></span></label><label>Status<select value="@panel.State" disabled="@busy.Contains(panel.Id)" @onchange="ChangeDailyState">@foreach(var state in DailyStates(panel)){<option value="@state.Name">@state.Name</option>}</select></label></div>
<details class="item-description"><summary>Description</summary>@if(string.IsNullOrWhiteSpace(ContentText.Plain(panel.Description))){<p class="muted">No description.</p>}else{<pre class="prose">@ContentText.Plain(panel.Description)</pre>}@if(!string.IsNullOrWhiteSpace(ContentText.Plain(panel.Acceptance))){<h4>Acceptance / testing</h4><pre class="prose">@ContentText.Plain(panel.Acceptance)</pre>}</details>
<div class="daily-panel-section"><div class="daily-panel-heading"><h3>Tags</h3>@if(Blocked(panel)){<span class="blocked-mark">Blocked</span>}</div><div class="tags">@foreach(var tag in panel.Tags){<span class="tag-chip @(prefs.BlockedTags.Contains(tag,StringComparer.OrdinalIgnoreCase)?"blocked-tag":"")">@tag <button class="tag-remove" @onclick="()=>RemoveDailyPanelTag(tag)">×</button></span>}</div>@if(SuggestedTags(panel).Length>0){<div class="daily-tag-suggestions"><span>Suggestions</span>@foreach(var tag in SuggestedTags(panel)){<button class="tag-suggestion" disabled="@busy.Contains(panel.Id)" @onclick="async()=>{await AddSuggestedTag((panel,tag));dailyPanelItem=items.FirstOrDefault(x=>x.Id==panel.Id)??panel;}">+ @tag</button>}</div>}<div class="daily-panel-add"><input list="daily-panel-tags" placeholder="Add tag…" @bind="dailyTagText"/><datalist id="daily-panel-tags">@foreach(var tag in TagSuggestions){<option value="@tag"></option>}</datalist><button disabled="@string.IsNullOrWhiteSpace(dailyTagText)" @onclick="AddDailyTag">Add</button></div></div>
<div class="daily-panel-section"><div class="daily-panel-heading"><h3>Comments</h3><span>@panel.CommentCount</span></div>@if(dailyPanelLoading){<p class="muted">Loading comments…</p>}else if(dailyComments.Count==0){<p class="muted">No comments yet.</p>}else{<div class="daily-comments">@foreach(var comment in dailyComments.TakeLast(20).Reverse()){<article><header><strong>@comment.Author</strong><small>@comment.Created.ToLocalTime().ToString("MMM d, HH:mm")</small></header><p>@ContentText.Plain(comment.Text)</p></article>}</div>}<textarea rows="3" placeholder="Add a comment to the PBI…" @bind="dailyCommentText"></textarea><button class="primary" disabled="@string.IsNullOrWhiteSpace(dailyCommentText)" @onclick="AddDailyComment">Add comment</button></div>
<div class="daily-panel-footer">@if(SafeLink(panel.Url)){<a target="_blank" rel="noopener noreferrer" href="@panel.Url">Open in Azure DevOps ↗</a>}</div></aside>}
@if(dialog!=""){
<div class="scrim"><section class="dialog @(dialog is "ai" or "review" or "prompt" or "smartorder" or "smartfix" or "magic" or "prabandon"?"wide":"")" role="dialog" aria-modal="true" aria-labelledby="dialog-title"><header><h2 id="dialog-title">@DialogTitle</h2><button disabled="@(applying||branchDeleting||pullRequestAbandoning)" aria-label="Close dialog" @onclick="CloseDialog">×</button></header>
@if(dialog=="palette") {<input autofocus aria-label="Find command" placeholder="Type a command…" @bind="commandSearch" @bind:event="oninput"/><div class="command-list">@foreach(var command in Commands.Where(c=>c.Contains(commandSearch,StringComparison.OrdinalIgnoreCase))){<button @onclick="()=>RunCommand(command)">@command</button>}</div>}
else if(dialog=="iterations") {<input aria-label="Search iterations" placeholder="Find sprint…" @bind="iterationSearch" @bind:event="oninput"/>@foreach(var i in meta!.Iterations.Where(i=>i.Path.Contains(iterationSearch,StringComparison.OrdinalIgnoreCase))){<button class="list-option" @onclick="()=>ChooseSprint(i)">@i.Name <small>@i.Path</small></button>}}
else if(dialog=="columns") {<p>ID and title stay visible.</p>@foreach(var c in AllColumns){<label class="checkbox"><input type="checkbox" checked="@prefs.Columns.Contains(c)" disabled="@(c is "ID" or "Title")" @onchange="()=>ToggleColumn(c)"/>@c</label>}}
else if(dialog=="saveview") {<label>View name<input @bind="viewName"/></label><button class="primary" @onclick="SaveView">Save view</button>}
else if(dialog=="smartorder") {<p>Smart Order will write the real Azure DevOps sprint order. Items are grouped by owner, then <strong>Done → Blocked → Active</strong>. Existing Azure DevOps order is preserved inside each group.</p><div class="smart-order-preview">@foreach(var ownerGroup in smartOrderPlan.GroupBy(x=>x.Owner)){<section><header><strong>@ownerGroup.Key</strong><span>@ownerGroup.Count() items</span></header>@foreach(var group in ownerGroup.GroupBy(x=>x.Group)){<div class="smart-order-group"><span class="smart-order-group-label @group.Key.ToLowerInvariant()">@group.Key</span>@foreach(var row in group){<div class="smart-order-row"><em>@row.Position</em><span>#@row.Item.Id · @row.Item.Title</span><small>@(row.Item.Order?.ToString("0.##")??"no current order")</small></div>}</div>}</section>}</div><div class="toolbar"><button disabled="@smartOrdering" @onclick="CloseDialog">Cancel</button><button class="primary" disabled="@smartOrdering" @onclick="ApplySmartOrder">@(smartOrdering?"Applying…":"Apply to Azure DevOps")</button></div>}
else if(dialog=="smartfix") {
<p>Smart Fix only targets missing <strong>application tags</strong>, missing estimates, and missing tags on the selected items. Initiative tags are optional and are never treated as missing. Estimates use the available work-item context; when Copilot cannot derive one, SprintPilot proposes the 3h default. Nothing is written to Azure DevOps until you review and apply the final diff.</p>
@if(smartFixSuggestions.Count==0){
<div class="smart-fix-gaps">@foreach(var gap in smartFixGaps){<article><header><strong>#@gap.Item.Id · @gap.Item.Title</strong><span>@SmartFixNeeds(gap)</span></header><div class="tags">@foreach(var tag in gap.Item.Tags){<span class="tag-chip">@tag</span>}@if(gap.Item.Tags.Length==0){<small>No current tags</small>}</div><details class="item-description compact"><summary>Description</summary>@if(string.IsNullOrWhiteSpace(ContentText.Plain(gap.Item.Description))){<p class="muted">No description.</p>}else{<pre class="prose">@ContentText.Plain(gap.Item.Description)</pre>}</details></article>}</div>
<label>Prompt for Copilot<textarea class="prompt-editor" rows="14" @bind="smartFixPrompt"></textarea></label>
<div class="toolbar smart-fix-actions"><button @onclick="CloseDialog">Cancel</button><button class="primary" @onclick="CopySmartFixPrompt">Copy prompt for Copilot</button></div>
<label>Paste Copilot JSON<textarea rows="12" @bind="smartFixCopilotText" placeholder="Paste Copilot's raw JSON response here…"></textarea></label>
<button class="primary" disabled="@string.IsNullOrWhiteSpace(smartFixCopilotText)" @onclick="ParseSmartFixCopilot">Import suggestions</button>
}else{
<div class="smart-fix-suggestions">@foreach(var suggestion in smartFixSuggestions){var gap=smartFixGaps.First(g=>g.Item.Id==suggestion.Id);<article><header><div><strong>#@suggestion.Id · @gap.Item.Title</strong>@if(suggestion.Reason!=""){<small>@suggestion.Reason</small>}</div><span>Choose what to apply</span></header><details class="item-description compact"><summary>Description</summary>@if(string.IsNullOrWhiteSpace(ContentText.Plain(gap.Item.Description))){<p class="muted">No description.</p>}else{<pre class="prose">@ContentText.Plain(gap.Item.Description)</pre>}</details><div class="smart-fix-options">@if(suggestion.ApplicationTag!=""){<label class="smart-fix-option"><input type="checkbox" @bind="suggestion.ApplyApplication"/><span><strong>Application tag</strong><small>@suggestion.ApplicationTag</small></span></label>}@if(suggestion.Estimate is not null){<label class="smart-fix-option"><input type="checkbox" @bind="suggestion.ApplyEstimate"/><span><strong>Estimate</strong><small>@suggestion.Estimate.Value.ToString("0.##")</small></span></label>}@if(suggestion.AddTags.Length>0){<label class="smart-fix-option"><input type="checkbox" @bind="suggestion.ApplyTags"/><span><strong>Add tags</strong><small>@string.Join("; ",suggestion.AddTags)</small></span></label>}</div></article>}</div>
<div class="toolbar smart-fix-actions"><button @onclick="()=>smartFixSuggestions=[]">Back to Copilot result</button><button class="primary" @onclick="ReviewSmartFix">Review selected changes</button></div>
}}
else if(dialog=="magic") {
<p>Magic Orchestration proposes <strong>owner changes only</strong>. SprintPilot pre-filters the candidate people using current-sprint capacity, estimates, application continuity and time off; Copilot can only choose from those candidates. No reassignment is written until you explicitly accept it and pass the final Azure DevOps review.</p>
@if(magicSuggestions.Count==0){
<div class="magic-context-list">@foreach(var context in magicContexts.Take(12)){<article><header><div><strong>#@context.Item.Id · @context.Item.Title</strong><small>@context.CurrentOwnerName · @context.CurrentPercent% load · @context.Estimate.ToString("0.##")h</small></div><span>@context.Candidates.Length candidates</span></header><div class="magic-candidate-chips">@foreach(var candidate in context.Candidates){<span>@candidate.Name · @candidate.CurrentPercent% → @candidate.ProjectedPercent%@if(candidate.SameApplicationItems>0){<em>same app</em>}</span>}</div><details class="item-description compact"><summary>Description</summary>@if(string.IsNullOrWhiteSpace(ContentText.Plain(context.Item.Description))){<p class="muted">No description.</p>}else{<pre class="prose">@ContentText.Plain(context.Item.Description)</pre>}</details></article>}</div>
<label>Prompt for Copilot<textarea class="prompt-editor" rows="18" @bind="magicPrompt"></textarea></label>
<div class="toolbar magic-actions"><button @onclick="CloseDialog">Cancel</button><button class="primary" @onclick="CopyMagicPrompt">Copy prompt for Copilot</button></div>
<label>Paste Copilot JSON<textarea rows="12" @bind="magicCopilotText" placeholder="Paste Copilot's raw JSON response here…"></textarea></label>
<button class="primary" disabled="@string.IsNullOrWhiteSpace(magicCopilotText)" @onclick="ParseMagicCopilot">Import recommendations</button>
}else{
<div class="magic-suggestions">@foreach(var suggestion in magicSuggestions){var context=MagicContextFor(suggestion.Id);var target=MagicTarget(suggestion);<article class="@suggestion.Decision"><header><div><strong>#@suggestion.Id · @context.Item.Title</strong><small>@context.CurrentOwnerName → @target.Name</small></div><span class="magic-confidence @suggestion.Confidence.ToLowerInvariant()">@suggestion.Confidence confidence</span></header><div class="magic-impact"><span><small>@context.CurrentOwnerName</small><strong>@context.CurrentPercent% → @context.SourceProjectedPercent%</strong></span><span>→</span><span><small>@target.Name</small><strong>@target.CurrentPercent% → @target.ProjectedPercent%</strong></span></div>@if(suggestion.Reason!=""){<p class="magic-reason">@suggestion.Reason</p>}<details class="item-description compact"><summary>Description</summary>@if(string.IsNullOrWhiteSpace(ContentText.Plain(context.Item.Description))){<p class="muted">No description.</p>}else{<pre class="prose">@ContentText.Plain(context.Item.Description)</pre>}@if(!string.IsNullOrWhiteSpace(ContentText.Plain(context.Item.Acceptance))){<h4>Acceptance / testing</h4><pre class="prose">@ContentText.Plain(context.Item.Acceptance)</pre>}</details><div class="magic-decision"><button class="accept @(suggestion.Decision=="accepted"?"active":"")" @onclick='()=>DecideMagic(suggestion,"accepted")'>✓ Accept</button><button class="ignore @(suggestion.Decision=="ignored"?"active":"")" @onclick='()=>DecideMagic(suggestion,"ignored")'>Ignore</button></div></article>}</div>
@if(MagicProjection().Count>0){<section class="magic-projection"><header><strong>Projected load after accepted moves</strong><span>@magicSuggestions.Count(s=>s.Decision=="accepted") accepted</span></header>@foreach(var row in MagicProjection()){<div><span>@row.Name</span><strong class="@(row.After>100?"over":"")">@row.Before% → @row.After%</strong></div>}</section>}
<div class="toolbar magic-actions"><span class="muted">@magicSuggestions.Count(s=>s.Decision=="pending") pending · @magicSuggestions.Count(s=>s.Decision=="accepted") accepted · @magicSuggestions.Count(s=>s.Decision=="ignored") ignored</span><button @onclick="()=>magicSuggestions=[]">Back to Copilot result</button><button class="primary" disabled="@(!magicSuggestions.Any(s=>s.Decision=="accepted")||magicSuggestions.Any(s=>s.Decision=="pending"))" @onclick="ReviewMagicOrchestration">Review accepted reassignments</button></div>
}}
else if(dialog=="branchdelete") {
<p><strong>This deletes Azure DevOps branch refs.</strong> SprintPilot will send the object ID you reviewed, so Azure DevOps rejects the deletion if the branch changes before you confirm.</p>
<div class="branch-delete-review">@foreach(var b in branchDeleteQueue){<article><div><strong>@b.Name</strong><small>@BranchReason(b)</small></div><span>@BranchAgeText(b)</span></article>}</div>
@if(branchDeleteResults.Count>0){<div class="branch-delete-results">@foreach(var r in branchDeleteResults){<p class="@(r.Success?"success":"error-text")">@(r.Success?"✓":"⚠") @r.Name @if(!r.Success){<text> — @r.Error</text>}</p>}</div>}
<div class="toolbar"><button disabled="@branchDeleting" @onclick="CloseDialog">@(branchDeleteResults.Count>0?"Close":"Cancel")</button>@if(branchDeleteResults.Count==0){<button class="primary danger-action" disabled="@branchDeleting" @onclick="DeleteBranchQueue">@(branchDeleting?"Deleting…":$"Delete {branchDeleteQueue.Count} branch{(branchDeleteQueue.Count==1?"":"es")}")</button>}</div>
}
else if(dialog=="prabandon") {
<p><strong>This abandons active Azure DevOps pull requests; it does not delete their source branches.</strong> SprintPilot re-checks that each PR is still active and that its source commit is unchanged before sending the status update.</p>
<div class="branch-delete-review pr-abandon-review">@foreach(var p in pullRequestAbandonQueue){<article><div><strong>#@p.Id · @p.Title</strong><small>@p.SourceBranch → @p.TargetBranch · @PullRequestReason(p)</small></div><span>@PullRequestAgeText(p)</span></article>}</div>
@if(pullRequestAbandonResults.Count>0){<div class="branch-delete-results">@foreach(var r in pullRequestAbandonResults){<p class="@(r.Success?"success":"error-text")">@(r.Success?"✓":"⚠") #@r.Id @if(!r.Success){<text> — @r.Error</text>}</p>}</div>}
<div class="toolbar"><button disabled="@pullRequestAbandoning" @onclick="CloseDialog">@(pullRequestAbandonResults.Count>0?"Close":"Cancel")</button>@if(pullRequestAbandonResults.Count==0){<button class="primary danger-action" disabled="@pullRequestAbandoning" @onclick="AbandonPullRequestQueue">@(pullRequestAbandoning?"Abandoning…":$"Abandon {pullRequestAbandonQueue.Count} pull request{(pullRequestAbandonQueue.Count==1?"":"s")}")</button>}</div>
}
else if(dialog=="bulk") {
<p>@SelectedItems.Count visible selected item(s). Hidden rows are never included in this action.</p><label>@BulkLabel
@if(bulkKind=="Owner"){<select @bind="bulkValue"><option value="">Unassigned</option>@foreach(var p in meta!.People){<option value="@p.UniqueName">@p.Name</option>}</select>}
else if(bulkKind=="State"){<select @bind="bulkValue"><option value="">Choose state…</option>@foreach(var s in CommonStates){<option>@s</option>}</select>}
else if(bulkKind is "Iteration" or "Next" or "Previous"){<select @bind="bulkValue"><option value="">Choose sprint…</option>@foreach(var i in meta!.Iterations){<option value="@i.Path">@i.Name</option>}</select>}
else if(bulkKind=="Area"){<select @bind="bulkValue"><option value="">Choose area…</option>@foreach(var a in meta!.Areas){<option>@a</option>}</select>}
else {<input @bind="bulkValue" placeholder="@(bulkKind=="Priority"?"1–4":"Tag")"/>}</label><button class="primary" @onclick="PreviewBulk">Review changes</button>}
else if(dialog=="review") {
<p>@pending.Count work items will be changed. Every update checks the original revision.</p><div class="review-scroll">@foreach(var u in pending){<article class="review-item"><h3>#@u.Original.Id — @u.Original.Title</h3><details class="item-description compact"><summary>Description</summary>@if(string.IsNullOrWhiteSpace(ContentText.Plain(u.Original.Description))){<p class="muted">No description.</p>}else{<pre class="prose">@ContentText.Plain(u.Original.Description)</pre>}</details><table class="diff"><thead><tr><th>Field</th><th>Current</th><th>Proposed</th></tr></thead><tbody>@foreach(var c in u.Changes){<tr><th>@c.Field</th><td><pre>@Display(u.Original,c.Field)</pre></td><td><pre>@ContentText.Plain(c.Value?.ToString()??"(empty)")</pre></td></tr>}</tbody></table></article>}</div>
@if(results.Count>0){<div class="notice" role="status">✓ @results.Count(r=>r.Success) updated · ⚠ @results.Count(r=>!r.Success) failed</div>@foreach(var failure in results.Where(r=>!r.Success)){<p class="error-text">#@failure.Id — @failure.Error</p>}}
<div class="toolbar"><button disabled="@applying" @onclick="CloseDialog">@(results.Count>0?"Close":"Cancel")</button>@if(results.Count==0){<button class="primary" disabled="@applying" @onclick="ApplyPending">@(applying?"Updating…":$"Apply {pending.Count} changes")</button>}else if(results.Any(r=>!r.Success)){<button class="primary" disabled="@applying" @onclick="RetryFailed">Refresh failed &amp; review retry</button>}</div>}
else if(dialog=="ai") {
@if(reviews.Length==0){<p>Paste the complete standardized response for @aiItems.Length item(s).</p><textarea aria-label="AI review response" rows="16" @bind="aiText"></textarea><button class="primary" @onclick="ParseAi">Preview review</button>}
else {<div class="review-scroll">@foreach(var review in reviews){var original=aiItems.Single(w=>w.Id==review.Id);<article class="review-item"><h3>#@review.Id — @original.Title</h3>@foreach(var c in ReviewChanges(review)){<h4>@c.Field</h4><div class="diff-pair"><div><small>Current</small><pre>@Display(original,c.Field)</pre></div><div><small>Proposed</small><pre>@ContentText.Plain(c.Value?.ToString()??"")</pre></div></div>}<h4>Questions / missing information</h4><pre class="prose">@review.Sections["QUESTIONS / MISSING INFORMATION"]</pre></article>}</div><div class="toolbar"><button @onclick="()=>reviews=[]">Back</button><button @onclick="ApplyAiLocally">Apply locally</button><button class="primary" @onclick="ReviewAiServer">Review Azure DevOps update</button></div>}}
else if(dialog=="prompt") {
<p>Review or adjust this prompt, then copy it into Copilot. SprintPilot will not change Azure DevOps from this screen.</p><textarea class="prompt-editor" aria-label="Copilot prompt" rows="24" @bind="promptText"></textarea><div class="toolbar"><button @onclick="CloseDialog">Cancel</button><button class="primary" @onclick="CopyPrompt">Copy to clipboard</button></div>
}
else if(dialog=="create") {
<label>Work-item type<select @bind="newType">@foreach(var t in meta!.Types){<option>@t.Name</option>}</select></label><label>Template<select @onchange="ApplyCreateTemplate"><option value="">Blank</option>@for(int i=0;i<prefs.Templates.Count;i++){<option value="@i">@prefs.Templates[i].Name</option>}</select></label><label>Title<input @bind="newTitle"/></label><label>Description<textarea rows="5" @bind="newDescription"></textarea></label><label>Acceptance criteria / testing<textarea rows="4" @bind="newAcceptance"></textarea></label>@if(!meta!.Types.First(t=>t.Name==newType).Fields.Contains("Microsoft.VSTS.Common.AcceptanceCriteria")){<p class="muted">This type has no acceptance-criteria field. These criteria will be included in its description.</p>}<label>Area<select @bind="newArea">@foreach(var a in meta!.Areas){<option>@a</option>}</select></label><label>Sprint<select @bind="newIteration">@foreach(var i in meta!.Iterations){<option value="@i.Path">@i.Name</option>}</select></label><label>Parent ID (optional)<input type="number" min="1" @bind="newParent"/></label><label>Tags<input @bind="newTags"/></label><button class="primary" disabled="@applying" @onclick="CreateItem">@(applying?"Creating…":"Create work item")</button>
}
@if(dialogError!=""){<p class="error-text" role="alert">@dialogError</p>}
</section></div>}
<div id="blazor-error-ui">SprintPilot lost its connection. <a href="/">Reload</a> to reconnect; refresh work items before retrying a change.</div>
